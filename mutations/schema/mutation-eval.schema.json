{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/mutations/schema/mutation-eval.schema.json",
  "title": "skill-mutation-eval/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "parent_sha",
    "candidate_sha",
    "metric",
    "target_case_ids",
    "non_target_case_ids",
    "evidence_bundles"
  ],
  "properties": {
    "schema_version": {"const": "skill-mutation-eval/v1"},
    "skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "parent_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "metric": {"const": "task_pass_rate"},
    "target_case_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "non_target_case_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "evidence_bundles": {
      "description": "For every target and non-target case, carries paired current(parent), candidate, and no-skill observations with equal repetition counts.",
      "type": "array", "minItems": 6, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
