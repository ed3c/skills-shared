      "start_edges": [
        {"from_node_id": "POL-ATOM-001", "to_node_id": "POL-ATOM-003", "satisfied_by": "READABLE_INTERFACE"}
      ],
      "completion_edges": [
        {"from_node_id": "POL-ATOM-002", "to_node_id": "POL-ATOM-003", "satisfied_by": "ADMITTED_RECEIPT"}
      ],
      "authority": {
        "merge": false,
        "release": false,
        "product_truth": false,
        "user_truth": false,
        "paid_truth": false,
        "rights_admission": false,
        "provider_execution": false,
        "production": false
      },
      "human_owned_operations": [
        "launching any session named here",
        "merge and release"
      ]
    }
  ],
