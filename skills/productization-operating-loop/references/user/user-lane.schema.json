        },
        "procurement_path": {"description": "synthetic", "evidence": {"kind": "OBSERVED_ARTIFACT", "note": "synthetic"}},
        "failure_recovery": {"description": "synthetic", "evidence": {"kind": "OBSERVED_ARTIFACT", "note": "synthetic"}},
        "retention_return_trigger": {"description": "synthetic", "evidence": {"kind": "INFERENCE", "note": "synthetic"}},
        "adoption_status": {"state": "EXPRESSED_INTEREST", "evidence": {"kind": "USER_INTERVIEW", "note": "synthetic"}},
        "falsifier": {"hypothesis": "synthetic hypothesis text long enough", "would_be_refuted_by": "synthetic refutation text long enough", "counterexample": "synthetic counterexample text long enough"}
      }
    },
    {
      "case_id": "POL-XC-USER-002",
      "refuses": "INTEREST_AS_ADOPTION: an expressed-interest signal filed as observed adoption.",
