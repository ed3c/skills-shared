        "time_to_first_value": {"state": "ESTIMATED", "evidence": {"kind": "INFERENCE", "note": "synthetic"}},
        "setup_burden": {"state": "LOW", "evidence": {"kind": "OBSERVED_ARTIFACT", "note": "synthetic"}},
        "account_api_key_burden": {"state": "LOW", "evidence": {"kind": "OBSERVED_ARTIFACT", "note": "synthetic"}},
        "permission_trust_burden": {"state": "NOT_ASSESSED", "evidence": {"kind": "INFERENCE", "note": "synthetic"}},
        "data_migration_burden": {"state": "NOT_ASSESSED", "evidence": {"kind": "INFERENCE", "note": "synthetic"}},
        "learning_cost": {"state": "LOW", "evidence": {"kind": "OBSERVED_ARTIFACT", "note": "synthetic"}},
        "switching_cost": {
          "state": "MODERATE",
          "willingness_to_switch": "CONFIRMED_SWITCH",
