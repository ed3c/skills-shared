          "changed_section": {"value": "section 4.2, synthetic", "evidence_class": "VERIFIED_READBACK"},
          "semantic_delta": {"value": "synthetic delta text", "evidence_class": "VERIFIED_READBACK"}
        },
        "affected_impact": {
          "capability": {"value": "synthetic capability", "evidence_class": "HYPOTHESIS"},
          "rights_note": {"value": "synthetic note", "evidence_class": "HYPOTHESIS"},
