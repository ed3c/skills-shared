{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.invalid/repository-control-plane-consumer-binding/v1",
  "title": "Repository Control Plane Consumer Binding",
  "description": "Thin, immutable-identity consumer attachment. It contains no Skill body, secret value, local absolute path, or live execution claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "consumer_repository_id",
    "profile",
    "skills",
    "runtime_env",
    "monitor",
    "projection",
    "authority",
    "generated_by"
  ],
  "properties": {
    "schema": {
      "const": "repository-control-plane/consumer-binding/v1"
    },
    "consumer_repository_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "const": "skills-shared-default"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "requirements_path",
        "binding_path",
        "selected",
        "body_policy"
      ],
      "properties": {
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_id",
            "url"
          ],
          "properties": {
            "repository_id": {
              "const": "ed3c/skills-shared"
            },
            "url": {
              "const": "https://github.com/ed3c/skills-shared"
            }
          }
        },
        "requirements_path": {
          "const": ".agents/shared-skills.requirements.json"
        },
        "binding_path": {
          "const": ".agents/bindings/repository-control-plane.json"
        },
        "selected": {
          "const": [
            "shared-skills-infra",
            "procedural-shadow-runtime",
            "agentic-tech-lead-orchestration",
            "spatial-loop-systems-engineering",
            "git-town-stacked-pr-worker",
            "dual-forge-repository-loop"
          ]
        },
        "body_policy": {
          "const": "CANONICAL_ONLY"
        }
      }
    },
    "runtime_env": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "commit_sha",
        "profile_ids",
        "workload_ids",
        "capabilities"
      ],
      "properties": {
        "repository_id": {
          "const": "ed3c/runtime-env"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "profile_ids": {
          "const": [
            "forgejo-delivery-keychain-local"
          ]
        },
        "workload_ids": {
          "const": [
            "forgejo-delivery-loop"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill_distribution",
            "git_town",
            "forgejo"
          ],
          "properties": {
            "skill_distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "owner",
                "setup_entrypoint",
                "probe_entrypoint",
                "without_receipt"
              ],
              "properties": {
                "scope": {
                  "const": "user"
                },
                "owner": {
                  "const": "skills-shared"
                },
                "setup_entrypoint": {
                  "const": "shared-skills-infra.install"
                },
                "probe_entrypoint": {
                  "const": "shared-skills-infra.check"
                },
                "without_receipt": {
                  "const": "NOT_EXERCISED"
                }
              }
            },
            "git_town": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "owner",
                "executable",
                "setup_entrypoint",
                "probe_entrypoint",
                "implementation_state",
                "without_receipt"
              ],
              "properties": {
                "scope": {
                  "const": "user"
                },
                "owner": {
                  "const": "runtime-env"
                },
                "executable": {
                  "const": "git-town"
                },
                "setup_entrypoint": {
                  "const": "repository-control-plane.install-git-town"
                },
                "probe_entrypoint": {
                  "const": "repository-control-plane.git-town-version"
                },
                "implementation_state": {
                  "enum": [
                    "IMPLEMENTED",
                    "NOT_IMPLEMENTED"
                  ]
                },
                "without_receipt": {
                  "const": "NOT_EXERCISED"
                }
              }
            },
            "forgejo": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "owner",
                "endpoint_variable",
                "profile_id",
                "workload_id",
                "probe_entrypoint",
                "without_receipt"
              ],
              "properties": {
                "scope": {
                  "const": "host"
                },
                "owner": {
                  "const": "runtime-env"
                },
                "endpoint_variable": {
                  "const": "FORGEJO_URL"
                },
                "profile_id": {
                  "const": "forgejo-delivery-keychain-local"
                },
                "workload_id": {
                  "const": "forgejo-delivery-loop"
                },
                "probe_entrypoint": {
                  "const": "credential-canary"
                },
                "without_receipt": {
                  "const": "NOT_EXERCISED"
                }
              }
            }
          }
        }
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "query",
        "mode",
        "polling_scope",
        "input_schema",
        "output_schema",
        "unfinished_states",
        "controller_chain"
      ],
      "properties": {
        "source": {
          "const": "github"
        },
        "query": {
          "const": "is:issue is:open"
        },
        "mode": {
          "const": "READ_ONLY_PLAN"
        },
        "polling_scope": {
          "const": "host"
        },
        "input_schema": {
          "const": "github-open-issues-snapshot/v1"
        },
        "output_schema": {
          "const": "repository-control-plane/monitor-plan/v1"
        },
        "unfinished_states": {
          "const": [
            "OPEN",
            "BLOCKED",
            "IN_PROGRESS",
            "NOT_EXERCISED"
          ]
        },
        "controller_chain": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "skill",
                "receipt"
              ],
              "properties": {
                "phase": {
                  "const": "BOOTSTRAP"
                },
                "skill": {
                  "const": "shared-skills-infra"
                },
                "receipt": {
                  "const": "skill-resolution"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "skill",
                "receipt"
              ],
              "properties": {
                "phase": {
                  "const": "SHADOW_ADMISSION"
                },
                "skill": {
                  "const": "procedural-shadow-runtime"
                },
                "receipt": {
                  "const": "shadow-admission"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "skill",
                "receipt"
              ],
              "properties": {
                "phase": {
                  "const": "TECH_LEAD_PLAN"
                },
                "skill": {
                  "const": "agentic-tech-lead-orchestration"
                },
                "receipt": {
                  "const": "task-dag"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "skill",
                "receipt"
              ],
              "properties": {
                "phase": {
                  "const": "SPATIAL_INVARIANTS"
                },
                "skill": {
                  "const": "spatial-loop-systems-engineering"
                },
                "receipt": {
                  "const": "spatial-invariants"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "skill",
                "receipt"
              ],
              "properties": {
                "phase": {
                  "const": "STACK_DELIVERY"
                },
                "skill": {
                  "const": "git-town-stacked-pr-worker"
                },
                "receipt": {
                  "const": "git-town-stack"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "skill",
                "receipt"
              ],
              "properties": {
                "phase": {
                  "const": "FORGE_RECONCILIATION"
                },
                "skill": {
                  "const": "dual-forge-repository-loop"
                },
                "receipt": {
                  "const": "dual-forge-reconciliation"
                }
              }
            }
          ]
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements_path",
        "control_plane_path",
        "binding_path",
        "surfaces"
      ],
      "properties": {
        "requirements_path": {
          "const": ".agents/shared-skills.requirements.json"
        },
        "control_plane_path": {
          "const": ".agents/repository-control-plane.json"
        },
        "binding_path": {
          "const": ".agents/bindings/repository-control-plane.json"
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claude",
            "codex"
          ],
          "properties": {
            "claude": {
              "const": ".claude/skills"
            },
            "codex": {
              "const": ".agents/skills"
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_mutation",
        "host_install",
        "automatic_merge",
        "automatic_conflict_resolution",
        "visibility_change",
        "skill_body_copy",
        "secret_values"
      ],
      "properties": {
        "consumer_mutation": {
          "const": "CONSUMER_POLICY_REQUIRED"
        },
        "host_install": {
          "const": "HOST_POLICY_REQUIRED"
        },
        "automatic_merge": {
          "const": false
        },
        "automatic_conflict_resolution": {
          "const": false
        },
        "visibility_change": {
          "const": false
        },
        "skill_body_copy": {
          "const": false
        },
        "secret_values": {
          "const": "DENY"
        }
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "const": "repository_control_plane.py"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    }
  }
}
