{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.invalid/repository-control-plane-monitor-plan/v1",
  "title": "Repository Control Plane Monitor Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "issues",
    "waves",
    "issue_plans",
    "automatic_merge",
    "automatic_conflict_resolution"
  ],
  "properties": {
    "schema": {"const": "repository-control-plane-monitor-plan/v1"},
    "issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity"}
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/identity"}
      }
    },
    "issue_plans": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identity"},
      "additionalProperties": {"$ref": "#/$defs/issue_plan"}
    },
    "automatic_merge": {"const": false},
    "automatic_conflict_resolution": {"const": false}
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[^/#\\s]+/[^#\\s]+#[1-9][0-9]*$"
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "receipt", "disposition"],
      "properties": {
        "phase": {
          "enum": [
            "BOOTSTRAP",
            "SHADOW_ADMISSION",
            "TECH_LEAD_PLAN",
            "SPATIAL_INVARIANTS",
            "STACK_DELIVERY",
            "FORGE_RECONCILIATION"
          ]
        },
        "receipt": {
          "enum": [
            "skill-resolution",
            "shadow-admission",
            "task-dag",
            "spatial-invariants",
            "git-town-stack",
            "dual-forge-reconciliation"
          ]
        },
        "disposition": {
          "enum": ["REQUIRED", "MONITOR", "NOT_APPLICABLE_WITH_EVIDENCE"]
        }
      }
    },
    "issue_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_dispositions", "required_receipts", "execution_state"],
      "properties": {
        "phase_dispositions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/disposition"},
                {
                  "properties": {
                    "phase": {"const": "BOOTSTRAP"},
                    "receipt": {"const": "skill-resolution"},
                    "disposition": {"const": "REQUIRED"}
                  }
                }
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/disposition"},
                {
                  "properties": {
                    "phase": {"const": "SHADOW_ADMISSION"},
                    "receipt": {"const": "shadow-admission"},
                    "disposition": {"const": "REQUIRED"}
                  }
                }
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/disposition"},
                {
                  "properties": {
                    "phase": {"const": "TECH_LEAD_PLAN"},
                    "receipt": {"const": "task-dag"},
                    "disposition": {"const": "REQUIRED"}
                  }
                }
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/disposition"},
                {
                  "properties": {
                    "phase": {"const": "SPATIAL_INVARIANTS"},
                    "receipt": {"const": "spatial-invariants"},
                    "disposition": {"enum": ["MONITOR", "REQUIRED"]}
                  }
                }
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/disposition"},
                {
                  "properties": {
                    "phase": {"const": "STACK_DELIVERY"},
                    "receipt": {"const": "git-town-stack"},
                    "disposition": {"enum": ["NOT_APPLICABLE_WITH_EVIDENCE", "REQUIRED"]}
                  }
                }
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/disposition"},
                {
                  "properties": {
                    "phase": {"const": "FORGE_RECONCILIATION"},
                    "receipt": {"const": "dual-forge-reconciliation"},
                    "disposition": {"enum": ["NOT_APPLICABLE_WITH_EVIDENCE", "REQUIRED"]}
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "required_receipts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "skill-resolution",
              "shadow-admission",
              "task-dag",
              "spatial-invariants",
              "git-town-stack",
              "dual-forge-reconciliation"
            ]
          }
        },
        "execution_state": {"const": "NOT_EXERCISED"}
      }
    }
  }
}
