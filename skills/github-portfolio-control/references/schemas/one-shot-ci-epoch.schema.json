    {
      "case_id": "GHPC-XC-CI-004",
      "refuses": "The hosted lane asked for before the local lane converged at that head.",
      "refused_by": "$defs.publication.allOf[0].then.properties.local_gates_pass_at_head.const",
      "instance": {
        "schema": "ghpc/one-shot-ci-epoch/v1",
        "ci_epoch_id": "GHPC-CI-104",
        "epoch_ref": {"main_commit": "3fc020414134999227aec6ba9304a08e86287033", "tree": "eea625614c233b7f42fd62c129aa21852cb36b9d"},
