        "classifier": "NONE",
        "code_head_config_unchanged": false
      },
      "semantic_acceptance": false,
      "merge_admission": "HUMAN_ADMIT_REQUIRED",
      "evidence_ceiling": "HOSTED_EXECUTION_ONLY",
      "authority": {
        "merge": false,
        "release": false,
        "promotion": false,
        "provider_execution": false,
