{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ghpc/one-shot-ci-epoch/v1",
  "title": "One-shot hosted CI epoch",
  "description": "One deliberate hosted run per candidate, and the record of what it did and did not establish. Hosted minutes are the one resource in this plane that is spent rather than described, and the two ways they get wasted look nothing alike: a candidate that pushes repair commits after asking for review buys a run per push, and a run that skipped every step reads in a summary exactly like one that passed. Four keywords hold the frugality. `pushes_after_ready` has a maximum of zero, so a repair is a new candidate rather than a second run. `ready_marked_count` has a maximum of one, so a draft/ready toggle cannot be used as a rerun button. A SUCCESS conclusion requires at least one non-empty step, so an empty workflow cannot be promoted. And `semantic_acceptance` is pinned false, so a green run stays hosted execution evidence and never becomes acceptance, merge, release or production readiness. What the schema cannot do is know whether the head it was handed is the head that was tested; that comparison is a bundle-level fact and the checker owns it as K06_CI_EPOCH_NOT_EXACT_HEAD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ci_epoch_id",
    "epoch_ref",
    "candidate",
    "publication",
    "hosted_run",
    "readback",
    "rerun",
    "semantic_acceptance",
    "merge_admission",
    "evidence_ceiling",
    "authority",
    "human_owned_operations"
  ],
  "properties": {
    "schema": {"const": "ghpc/one-shot-ci-epoch/v1"},
    "ci_epoch_id": {
      "type": "string",
      "pattern": "^GHPC-CI-[0-9]{3}$",
      "description": "Identifiers in the 900-999 block are reserved for shape-only instances inside `examples`; the checker refuses one inside a real bundle."
    },
    "epoch_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_commit", "tree"],
      "properties": {
        "main_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "candidate": {"$ref": "#/$defs/candidate"},
    "publication": {"$ref": "#/$defs/publication"},
    "hosted_run": {"$ref": "#/$defs/hosted_run"},
    "readback": {"$ref": "#/$defs/readback"},
    "rerun": {"$ref": "#/$defs/rerun"},
    "semantic_acceptance": {
      "const": false,
      "description": "Pinned. MERGEABLE_TRUE_PROMOTED_TO_SEMANTIC_PASS and a green workflow are the same promotion wearing two faces: the provider answered a question about conflicts or about execution, and neither question was whether the change is right."
    },
    "merge_admission": {
      "const": "HUMAN_ADMIT_REQUIRED",
      "description": "The only value. A hosted run cannot admit its own merge, and neither can the record of one."
    },
    "evidence_ceiling": {
      "const": "HOSTED_EXECUTION_ONLY",
      "description": "A workflow ran on a named head, and nothing more."
    },
    "authority": {"$ref": "#/$defs/authority"},
    "human_owned_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 4}
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["hosted_run"],
        "properties": {
          "hosted_run": {
            "required": ["hosted_evidence_grade"],
            "properties": {"hosted_evidence_grade": {"const": "EXECUTION_OBSERVED"}}
          }
        }
      },
      "then": {
        "properties": {
          "readback": {
            "properties": {
              "tested_head_equals_candidate_head": {
                "const": true,
                "description": "A receipt from another head is a receipt about another change."
              }
            }
          }
        }
      },
      "description": "OLD_HEAD_WORKFLOW_RECEIPT_REUSED. A run only counts as execution evidence for the head it actually tested, and the head it tested is compared to the candidate head by the checker as well, because an attestation is one arrival."
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_number", "base_commit", "head_commit", "changed_path_denominator", "frozen"],
      "description": "What is being asked about, frozen before the single push. Freezing is what makes one run enough: an unfrozen candidate produces the next push while the first run is still going.",
      "properties": {
        "pr_number": {"type": "integer", "minimum": 1},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "changed_path_denominator": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300},
          "description": "Every path the candidate touches, listed. A candidate whose denominator is empty is a candidate nobody can check for an overlapping writer."
        },
        "frozen": {
          "const": true,
          "description": "Pinned. An epoch that describes an unfrozen candidate describes a moving target and buys a hosted run per movement."
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_state",
        "draft_first_policy",
        "draft_phase_pushes",
        "ready_marked_count",
        "pushes_after_ready",
        "local_gates_pass_at_head"
      ],
      "properties": {
        "publication_state": {"enum": ["NOT_PUBLISHED", "DRAFT", "READY_FOR_REVIEW"]},
        "draft_first_policy": {
          "const": true,
          "description": "Pinned. Publishing as Draft is what keeps the hosted lane unrequested while local convergence is still happening; an artifact that could turn it off could spend a run per intermediate push."
        },
        "draft_phase_pushes": {
          "type": "integer",
          "minimum": 0,
          "description": "Pushes made while the candidate was still a draft. Any number is allowed; that is the point of the draft phase."
        },
        "ready_marked_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "DRAFT_OR_SYNCHRONIZE_CI_SPAM. Toggling ready is the cheapest way to buy another hosted run without admitting to a rerun, so the count is capped at the one deliberate request."
        },
        "pushes_after_ready": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0,
          "description": "Zero. A change after the request is a new candidate and a new epoch, not a correction to this one."
        },
        "local_gates_pass_at_head": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "required": ["publication_state"],
            "properties": {"publication_state": {"const": "READY_FOR_REVIEW"}}
          },
          "then": {
            "properties": {
              "local_gates_pass_at_head": {
                "const": true,
                "description": "The hosted lane is asked once, after the local lane is finished. Asking first is how one run becomes five."
              }
            }
          },
          "description": "Local convergence precedes the request, not the other way round."
        },
        {
          "if": {
            "required": ["publication_state"],
            "properties": {"publication_state": {"const": "NOT_PUBLISHED"}}
          },
          "then": {
            "properties": {
              "ready_marked_count": {
                "maximum": 0,
                "description": "Nothing was published, so nothing was marked ready."
              }
            }
          },
          "description": "The unpublished state has to stay describable, and it has to stay honest about what it did not do."
        }
      ]
    },
    "hosted_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_state",
        "run_id",
        "tested_head",
        "conclusion",
        "hosted_evidence_grade",
        "jobs",
        "non_empty_steps",
        "artifacts"
      ],
      "properties": {
        "execution_state": {"enum": ["EXERCISED", "NOT_EXERCISED"]},
        "run_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "tested_head": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$",
          "description": "The exact commit the hosted job checked out. A ref name fails the pattern: the run tested whatever the ref pointed at, and by the time the receipt is read that may be a different change."
        },
        "conclusion": {"enum": ["SUCCESS", "FAILURE", "CANCELLED", "SKIPPED", "NOT_EXERCISED"]},
        "hosted_evidence_grade": {
          "enum": ["EXECUTION_OBSERVED", "NOT_EVIDENCE"],
          "description": "Whether anything actually executed. Kept separate from `conclusion` because a run that skipped every job still concludes."
        },
        "jobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "non_empty_steps": {
          "type": "integer",
          "minimum": 0,
          "description": "Steps that ran a command and produced output. Zero on a SUCCESS is EMPTY_OR_SKIPPED_WORKFLOW_PROMOTED_TO_PASS."
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      },
      "allOf": [
        {
          "if": {"required": ["execution_state"], "properties": {"execution_state": {"const": "EXERCISED"}}},
          "then": {
            "properties": {
              "run_id": {
                "type": "string",
                "description": "An exercised run has an identity somebody else can fetch."
              }
            }
          },
          "description": "An exercised run with no id is a claim with no readback."
        },
        {
          "if": {"required": ["conclusion"], "properties": {"conclusion": {"const": "SUCCESS"}}},
          "then": {
            "properties": {
              "non_empty_steps": {
                "minimum": 1,
                "description": "Success with nothing executed is the shape of a workflow whose only job was filtered out by a paths rule."
              }
            }
          },
          "description": "EMPTY_OR_SKIPPED_WORKFLOW_PROMOTED_TO_PASS, step half."
        },
        {
          "if": {"required": ["conclusion"], "properties": {"conclusion": {"const": "SUCCESS"}}},
          "then": {
            "properties": {
              "jobs": {
                "minItems": 1,
                "description": "Success with no jobs is the same promotion one level up."
              }
            }
          },
          "description": "EMPTY_OR_SKIPPED_WORKFLOW_PROMOTED_TO_PASS, job half, kept separate so each half fails on its own keyword."
        },
        {
          "if": {
            "required": ["conclusion"],
            "properties": {"conclusion": {"enum": ["SKIPPED", "CANCELLED", "NOT_EXERCISED"]}}
          },
          "then": {
            "properties": {
              "hosted_evidence_grade": {
                "const": "NOT_EVIDENCE",
                "description": "Nothing executed, so nothing was observed."
              }
            }
          },
          "description": "A skipped or cancelled run graded as execution evidence is the quietest of the CI promotions, because the summary line still says the workflow completed."
        }
      ]
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tested_head_equals_candidate_head",
        "jobs_read_back",
        "steps_read_back",
        "artifacts_read_back"
      ],
      "description": "What was actually fetched back after the run, as four separate facts. A single `read_back: true` would let one fetched field stand for four.",
      "properties": {
        "tested_head_equals_candidate_head": {"type": "boolean"},
        "jobs_read_back": {"type": "boolean"},
        "steps_read_back": {"type": "boolean"},
        "artifacts_read_back": {"type": "boolean"}
      }
    },
    "rerun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rerun_count", "classifier", "code_head_config_unchanged"],
      "properties": {
        "rerun_count": {"type": "integer", "minimum": 0},
        "classifier": {"enum": ["NONE", "INFRASTRUCTURE_FLAKE_PROVEN"]},
        "code_head_config_unchanged": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"required": ["rerun_count"], "properties": {"rerun_count": {"minimum": 1}}},
          "then": {
            "properties": {
              "classifier": {
                "enum": ["INFRASTRUCTURE_FLAKE_PROVEN"],
                "description": "A rerun needs a reason that is not hope."
              }
            }
          },
          "description": "BLIND_RERUN_AFTER_CODE_FAILURE. A code or test failure returns to a new local candidate epoch; only a proven infrastructure flake earns the same head twice."
        },
        {
          "if": {
            "required": ["classifier"],
            "properties": {"classifier": {"const": "INFRASTRUCTURE_FLAKE_PROVEN"}}
          },
          "then": {
            "properties": {
              "code_head_config_unchanged": {
                "const": true,
                "description": "The proof is that nothing about the subject changed. Without it the classifier is a label."
              }
            }
          },
          "description": "The classifier has to be earned by the one comparison that distinguishes a flake from a fix."
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge", "release", "promotion", "provider_execution", "production"],
      "properties": {
        "merge": {"const": false},
        "release": {"const": false},
        "promotion": {"const": false},
        "provider_execution": {"const": false},
        "production": {"const": false}
      }
    }
  },
  "examples": [
    {
      "schema": "ghpc/one-shot-ci-epoch/v1",
      "ci_epoch_id": "GHPC-CI-001",
      "epoch_ref": {
        "main_commit": "3fc020414134999227aec6ba9304a08e86287033",
