      },
      "human_owned_operations": ["merge and release"]
    }
  ],
  "x-refusal-controls": [
    {
      "case_id": "GHPC-XC-CI-001",
      "refuses": "A repair pushed after the single review request, which buys a second hosted run.",
      "refused_by": "$defs.publication.properties.pushes_after_ready.maximum",
      "instance": {
        "schema": "ghpc/one-shot-ci-epoch/v1",
        "ci_epoch_id": "GHPC-CI-101",
