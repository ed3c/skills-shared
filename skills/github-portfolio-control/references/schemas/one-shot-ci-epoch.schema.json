        "jobs": [],
        "non_empty_steps": 0,
        "artifacts": []
      },
      "readback": {
        "tested_head_equals_candidate_head": false,
        "jobs_read_back": false,
        "steps_read_back": false,
        "artifacts_read_back": false
      },
      "rerun": {
