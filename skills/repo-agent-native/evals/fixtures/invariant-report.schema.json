{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "routes", "tools", "facts", "negative_invariants", "implicit_dependencies", "open_questions", "named_exclusions", "state"],
  "properties": {
    "schema": {"type": "string", "const": "repo-agent-native/invariant-report/v2"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "observed_commit", "observed_tree", "scope", "task"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "observed_commit": {"type": ["string", "null"]},
        "observed_tree": {"type": ["string", "null"]},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "task": {"type": "string", "minLength": 1}
      }
    },
    "routes": {"type": "array", "items": {"type": "string"}},
    "tools": {"type": "array", "items": {"type": "string"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "negative_invariants": {"type": "array", "items": {"$ref": "#/$defs/negative"}},
    "implicit_dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "named_exclusions": {"type": "array", "items": {"type": "string"}},
    "state": {"type": "string", "enum": ["PASS", "FAIL", "ABSENT", "NOT_IMPLEMENTED", "NOT_EXERCISED", "SKIPPED_BY_POLICY"]}
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operator", "value"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "retry.result_contract",
            "retry.max_attempts",
            "retry.delay_ms",
            "retry.delay_strategy",
            "metrics.failure_mode",
            "metrics.observability_sink"
          ]
        },
        "operator": {"type": "string", "const": "equals"},
        "value": {
          "type": ["string", "number", "integer", "boolean", "null"]
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "claim", "predicate", "evidence_level", "source_refs", "verification"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "predicate": {"$ref": "#/$defs/predicate"},
        "evidence_level": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
        "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["source-read", "document-read", "manifest-read", "test-executed", "runtime-observed", "inference"]}}
      }
    },
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "claim", "predicate", "evidence_level", "source_refs", "verification", "search_boundary", "counterexample_sought"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "predicate": {"$ref": "#/$defs/predicate"},
        "evidence_level": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
        "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["source-read", "document-read", "manifest-read", "test-executed", "runtime-observed", "inference"]}},
        "search_boundary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "counterexample_sought": {"type": "string", "minLength": 1}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "claim", "predicate", "evidence_level", "source_refs", "verification"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "predicate": {"$ref": "#/$defs/predicate"},
        "evidence_level": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
        "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["source-read", "document-read", "manifest-read", "test-executed", "runtime-observed", "inference"]}}
      }
    }
  }
}
