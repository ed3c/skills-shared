{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.invalid/held-out-corpus/v1",
  "title": "Held-out Repository Audit Corpus",
  "description": "The frozen evaluation corpus for repository-capability-audit, bound before any live treatment result is observed. Running a live Agent against the fixtures used to design RCA-001..013 measures memorization, not capability, so this file exists to make the separation checkable rather than asserted. It stores public case metadata and digests only: holdout labels, expected defects and evaluator ground truth are sealed and resolved inside a trusted evaluation runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "frozen_at_commit",
    "repositories",
    "task_families",
    "evaluator",
    "sealed_material"
  ],
  "properties": {
    "schema": {"const": "held-out-corpus/v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "frozen_at_commit": {
      "comment": "The skills-shared commit this corpus was frozen against. Freezing after observing a treatment result would let the corpus be tuned to the answer.",
      "$ref": "#/$defs/git_sha"
    },
    "repositories": {
      "comment": "At least three, and none of them a repository used to design the RCA-001..013 fixtures.",
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "commit_sha",
          "tree_sha",
          "language",
          "build_shape",
          "capability_boundary",
          "license_state",
          "authorization_state",
          "used_to_design_fixtures",
          "prerequisites",
          "cleanup_policy"
        ],
        "properties": {
          "repository_id": {"type": "string", "minLength": 3},
          "commit_sha": {"$ref": "#/$defs/git_sha"},
          "tree_sha": {"$ref": "#/$defs/git_sha"},
          "language": {"type": "string", "minLength": 1},
          "build_shape": {"type": "string", "minLength": 1},
          "capability_boundary": {"type": "string", "minLength": 1},
          "license_state": {"type": "string", "minLength": 1},
          "authorization_state": {"enum": ["PUBLIC", "PRIVATE_AUTHORIZED", "PRIVATE_UNAUTHORIZED"]},
          "used_to_design_fixtures": {
            "comment": "Recorded per repository rather than assumed for the set: a corpus that quietly reuses one tuning repository is not held out, and the reuse is invisible once the set is averaged.",
            "type": "boolean"
          },
          "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "cleanup_policy": {"type": "string", "minLength": 1}
        }
      }
    },
    "task_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family_id", "repository_id", "hidden_task_digest", "ground_truth_digest", "required_evidence_levels", "forbidden_evidence_levels", "expected_non_claims"],
        "properties": {
          "family_id": {"$ref": "#/$defs/family_id"},
          "repository_id": {"type": "string", "minLength": 3},
          "hidden_task_digest": {"$ref": "#/$defs/sha256"},
          "ground_truth_digest": {"$ref": "#/$defs/sha256"},
          "required_evidence_levels": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "forbidden_evidence_levels": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "expected_non_claims": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "version", "digest", "owner", "hard_gates"],
      "properties": {
        "evaluator_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"},
        "owner": {
          "comment": "Who runs the evaluator. EVALUATED_AGENT is absent from this enum on purpose: an Agent scoring itself is not an experiment, and the harness already refuses it.",
          "enum": ["INDEPENDENT_DETERMINISTIC", "INDEPENDENT_HUMAN", "INDEPENDENT_EXTERNAL_JUDGE"]
        },
        "hard_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hard_gate"}
        }
      }
    },
    "sealed_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "visible_to_evaluated_agent", "resolved_in"],
      "properties": {
        "location": {
          "comment": "A reference, never the material. A corpus file carrying the answers is not sealed.",
          "type": "string",
          "minLength": 1
        },
        "visible_to_evaluated_agent": {"const": false},
        "resolved_in": {"enum": ["TRUSTED_EVALUATION_RUNTIME"]}
      }
    }
  },
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "family_id": {
      "comment": "The families #224 names. Non-trigger and wrong-Skill controls are members, not afterthoughts: a corpus without them measures only whether an Agent escalates, never whether it correctly declines to.",
      "enum": [
        "real-capability-with-evidence",
        "overstated-readme-claim",
        "skipped-or-absent-integration",
        "invalid-denial-probe",
        "failure-path-evidence-loss",
        "post-publication-artifact-omission",
        "mutable-external-identity",
        "credential-bound-execution",
        "text-only-non-trigger",
        "metadata-only-control",
        "wrong-skill-control"
      ]
    },
    "hard_gate": {
      "enum": [
        "exact-subject-continuity",
        "required-command-runtime-arrival",
        "evidence-packet-digest-continuity",
        "valid-positive-and-negative-controls",
        "false-pass-detection",
        "explicit-non-claim-bounds"
      ]
    }
  }
}
