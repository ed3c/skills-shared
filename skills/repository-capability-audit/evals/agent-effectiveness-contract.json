{
  "schema": "repository-capability-audit-agent-effectiveness-contract/v1",
  "evidence_state": "NOT_EXERCISED",
  "profiles": {
    "no_skill": {"kind": "baseline"},
    "current_full_composition": {"kind": "full-treatment"},
    "candidate_trimmed_skill": {"kind": "trimmed-treatment"},
    "candidate_minus_prefix": "candidate_minus_RCA-"
  },
  "agent_classes": [
    "language_model_agent",
    "deterministic_fixture"
  ],
  "matching_fields": [
    "case_id",
    "repository_id",
    "repository_subject.commit",
    "repository_subject.tree",
    "repetition",
    "task_digest",
    "evaluator_digest",
    "agent.provider",
    "agent.family",
    "agent.model",
    "agent.version",
    "agent.harness",
    "agent.harness_version",
    "runtime.identity",
    "runtime.version",
    "runtime.toolset_digest",
    "budgets.timeout_seconds",
    "budgets.max_tool_calls",
    "budgets.max_input_tokens",
    "budgets.max_output_tokens"
  ],
  "required_metrics": [
    "task_success",
    "material_defects_found",
    "material_defects_total",
    "false_pass_count",
    "false_pass_opportunities",
    "evidence_packet_complete",
    "exact_subject_continuity",
    "negative_control_valid",
    "explicit_non_claim_accuracy",
    "trigger_correct",
    "tool_calls",
    "input_tokens",
    "output_tokens",
    "duration_ms",
    "cost_usd"
  ],
  "quality_weights": {
    "task_success": 0.30,
    "defect_recall": 0.20,
    "false_pass_avoidance": 0.15,
    "evidence_packet_complete": 0.10,
    "exact_subject_continuity": 0.10,
    "negative_control_valid": 0.05,
    "explicit_non_claim_accuracy": 0.05,
    "trigger_correct": 0.05
  },
  "acceptance": {
    "minimum_repetitions_per_cell": 5,
    "minimum_model_families": 2,
    "minimum_held_out_repositories": 3,
    "bootstrap_samples": 2000,
    "bootstrap_seed": 20260815,
    "candidate_vs_no_skill": {
      "minimum_mean_quality_uplift": 0.10,
      "require_positive_ci_lower_bound": true,
      "false_passes_must_not_increase": true
    },
    "candidate_vs_full": {
      "equivalence_margin": 0.05
    },
    "rule_retention": {
      "minimum_matched_pairs": 2,
      "minimum_mean_quality_delta": 0.02,
      "require_positive_ci_lower_bound": true
    }
  },
  "admission_states": [
    "NOT_EXERCISED",
    "HARNESS_SELFTEST_ONLY",
    "INSUFFICIENT_SAMPLE",
    "INVALID_EXPERIMENT",
    "NOT_SUPPORTED",
    "SUPPORTED"
  ]
}
