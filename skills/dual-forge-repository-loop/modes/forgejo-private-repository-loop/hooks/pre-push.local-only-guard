#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"
mode_root="$(git config --local --get repository.localOnlyModeRoot 2>/dev/null || true)"
[ -n "${mode_root}" ] || {
  echo "PRIVATE-LINEAGE GUARD: admitted mode root is absent." >&2
  exit 73
}

host="$(PYTHONPATH="${mode_root}/scripts${PYTHONPATH:+:${PYTHONPATH}}" python3 - "${remote_url}" <<'PY'
import sys
from url_policy import parse
print(parse(sys.argv[1]).host)
PY
)"
case "${host}" in
  github.com|api.github.com|*.github.com|*.githubusercontent.com)
    echo "PRIVATE-LINEAGE GUARD: GitHub destination is forbidden." >&2
    exit 72
    ;;
esac

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -z "${repo_root}" ] || [ -z "${common_dir}" ]; then
  echo "PRIVATE-LINEAGE GUARD: Git worktree identity is unavailable." >&2
  exit 73
fi
case "${common_dir}" in
  /*) ;;
  *) common_dir="${repo_root}/${common_dir}" ;;
esac

marker="${common_dir}/LOCAL_ONLY_CLASSIFICATION"
[ -f "${marker}" ] || {
  echo "PRIVATE-LINEAGE GUARD: classification marker is absent." >&2
  exit 73
}

classification="$(git config --local --get repository.classification || true)"
allowed_remote="$(git config --local --get repository.localOnlyRemote || true)"
allowed_url="$(git config --local --get repository.localOnlyURL || true)"
allowed_host="$(git config --local --get repository.localOnlyHost || true)"
expected_guard="$(git config --local --get repository.localOnlyGuardSha256 || true)"
actual_guard="$(python3 - "${BASH_SOURCE[0]}" <<'PY'
import hashlib, pathlib, sys
print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())
PY
)"

[ "${classification}" = "LOCAL_ONLY" ] || {
  echo "PRIVATE-LINEAGE GUARD: repository classification is not LOCAL_ONLY." >&2
  exit 73
}
[ -n "${allowed_remote}" ] && [ "${remote_name}" = "${allowed_remote}" ] || {
  echo "PRIVATE-LINEAGE GUARD: remote is not the exact admitted Forgejo remote." >&2
  exit 74
}
[ -n "${allowed_url}" ] && [ "${remote_url}" = "${allowed_url}" ] || {
  echo "PRIVATE-LINEAGE GUARD: destination URL differs from the admitted URL." >&2
  exit 75
}
[ -n "${allowed_host}" ] && [ "${host}" = "${allowed_host}" ] || {
  echo "PRIVATE-LINEAGE GUARD: destination host differs from the admitted host." >&2
  exit 76
}
[ -n "${expected_guard}" ] && [ "${expected_guard}" = "${actual_guard}" ] || {
  echo "PRIVATE-LINEAGE GUARD: guard bytes differ from the admitted digest." >&2
  exit 78
}

if [ -n "${GIT_ALTERNATE_OBJECT_DIRECTORIES:-}" ] || [ -s "${common_dir}/objects/info/alternates" ]; then
  echo "PRIVATE-LINEAGE GUARD: alternate object stores are forbidden." >&2
  exit 77
fi

configured="$(git remote get-url --push "${remote_name}" 2>/dev/null || true)"
[ "${configured}" = "${allowed_url}" ] || {
  echo "PRIVATE-LINEAGE GUARD: configured push URL moved after admission." >&2
  exit 75
}

echo "PRIVATE-LINEAGE GUARD: exact Forgejo-only destination admitted."
