{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.invalid/system-prompt-runtime-receipt/v1",
  "title": "System Prompt Runtime Receipt",
  "description": "Evidence that an exact System Prompt was exercised in a named runtime and admitted by a replayable verifier. Prompt prose is not runtime execution, task success, portable effectiveness, or recording authority; this receipt is what separates them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "prompt",
    "evaluation_contract",
    "runtime",
    "execution",
    "verification",
    "promotion",
    "record_states"
  ],
  "properties": {
    "schema": {"const": "system-prompt-runtime-receipt/v1"},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_id",
        "version",
        "content_sha256",
        "source_repository",
        "source_commit",
        "source_path",
        "composition_skills"
      ],
      "properties": {
        "prompt_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_repository": {"type": "string", "minLength": 3},
        "source_commit": {"$ref": "#/$defs/git_sha"},
        "source_path": {"type": "string", "minLength": 1},
        "composition_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "directory_digest"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "directory_digest": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "evaluation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "suite_sha256", "case_ids", "acceptance_predicates", "negative_controls", "baseline_condition"],
      "properties": {
        "suite_id": {"type": "string", "minLength": 1},
        "suite_sha256": {"$ref": "#/$defs/sha256"},
        "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "acceptance_predicates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "negative_controls": {
          "comment": "An empty control set is an absent control set, not a passing one.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "baseline_condition": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "harness_identity", "model_identity", "subject_sha", "environment_digest", "effect_policy", "bootstrap_receipt_digest"],
      "properties": {
        "identity": {"$ref": "#/$defs/runtime_identity"},
        "harness_identity": {"type": "string", "minLength": 1},
        "model_identity": {"type": "string", "minLength": 1},
        "subject_sha": {"$ref": "#/$defs/git_sha"},
        "environment_digest": {"$ref": "#/$defs/sha256"},
        "effect_policy": {"enum": ["READ_ONLY", "BOUNDED_WRITE", "UNBOUNDED"]},
        "bootstrap_receipt_digest": {
          "comment": "Binds this receipt to a skill-resolution-receipt/v1. ABSENT means bootstrap was never proven.",
          "$ref": "#/$defs/sha256_or_absent"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "started_at", "ended_at", "repetition_identity", "trace_digest", "artifact_digests", "terminal_state"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "started_at": {"$ref": "#/$defs/rfc3339"},
        "ended_at": {"$ref": "#/$defs/rfc3339"},
        "repetition_identity": {"type": "string", "minLength": 1},
        "trace_digest": {"$ref": "#/$defs/sha256"},
        "artifact_digests": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "terminal_state": {"enum": ["COMPLETED", "FAILED", "TIMED_OUT", "CANCELLED", "NOT_EXERCISED"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "verifier_digest", "replay_inputs_digest", "result", "negative_control_results", "unsupported_claims"],
      "properties": {
        "verifier_id": {"type": "string", "minLength": 1},
        "verifier_digest": {"$ref": "#/$defs/sha256"},
        "replay_inputs_digest": {"$ref": "#/$defs/sha256"},
        "result": {"enum": ["PASS", "FAIL", "NOT_EXERCISED"]},
        "negative_control_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "state"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "state": {"enum": ["KILLED", "SURVIVED", "NOT_EXERCISED"]}
            }
          }
        },
        "unsupported_claims": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted_scope", "authority", "baseline_comparison", "regressions", "release_admit_state", "revocation_subject"],
      "properties": {
        "admitted_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority": {"enum": ["LOCAL_RECORD", "PORTABLE_RECORD", "NONE"]},
        "baseline_comparison": {"type": "string", "minLength": 1},
        "regressions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "release_admit_state": {"enum": ["ADMITTED", "HUMAN_ADMIT_REQUIRED", "REFUSED"]},
        "revocation_subject": {"type": "string", "minLength": 1}
      }
    },
    "record_states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record_state"}},
    "observed_stacks": {
      "comment": "Distinct runtime/harness/model stacks this prompt was exercised on. Portable authority is a claim about more than one.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256_or_absent": {
      "oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"const": "ABSENT"}]
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "runtime_identity": {
      "enum": [
        "CHATGPT_GITHUB_CONNECTOR",
        "GITHUB_ACTIONS",
        "CLAUDE_CODE_LOCAL",
        "CODEX_CLI_LOCAL",
        "CHATGPT_DESKTOP_WORKTREE",
        "UNKNOWN"
      ]
    },
    "record_state": {
      "enum": [
        "AUTHORED",
        "CANDIDATE_BOUND",
        "EVAL_CONTRACT_BOUND",
        "RUNTIME_BOOTSTRAP_PASS",
        "RUNTIME_EXECUTED",
        "EXECUTOR_EVIDENCE_CAPTURED",
        "DETERMINISTIC_VERIFIER_PASS",
        "NEGATIVE_CONTROLS_PASS",
        "RECEIPT_BUNDLE_REPLAY_PASS",
        "SCOPE_DECIDED",
        "LOCAL_RECORD_ELIGIBLE",
        "PORTABLE_RECORD_ELIGIBLE",
        "RELEASE_ADMIT_REQUIRED",
        "RECORDED",
        "PROJECTED",
        "ABSENT",
        "NOT_EXERCISED",
        "STALE_PROMPT",
        "STALE_RUNTIME",
        "SUBJECT_MISMATCH",
        "BOOTSTRAP_FAIL",
        "EXECUTION_FAIL",
        "VERIFIER_FAIL",
        "CONTROL_FAIL",
        "REPLAY_FAIL",
        "REGRESSION",
        "SCOPE_OVERCLAIM",
        "RECEIPT_REVOKED",
        "SUPERSEDED",
        "HUMAN_ADMIT_REQUIRED"
      ]
    }
  }
}
