  "eligibility": {
    "frozen_rule": "PORTABLE_CANDIDATE requires the candidate to show no hard regression against the strongest baseline arm on the deterministic verifier, on every stack. A regression on any stack is disqualifying, because portability is a claim about all of them.",
    "mechanical_outcome": "no hard regression against the strongest baseline on either stack",
    "outcome": "INDETERMINATE",
    "why_not_not_eligible": "The candidate regressed on nothing. Reporting ineligibility would be the same error with the sign flipped.",
    "why_not_portable_candidate": "Applying the frozen rule to a metric this run has just shown to be lexical would report a portability result the evidence does not carry. The preregistration's own non-claim already covers it: a difference inside the per-cell spread is not a finding, and the observed gap is one rule name against a spread of one."
  },
  "failed_cells": 0,
  "issue": 229,
  "known_confounds": [
    {
      "confound": "prompt carrier",
      "detail": "Claude Code takes the prompt through a system-prompt channel and Codex CLI has none, so the bytes arrive as instruction text. Every cross-stack difference is confounded with carrier.",
      "how_to_separate": "a harness that offers both carriers, or a second Claude arm carrying the prompt as an instruction prefix",
      "why_not_corrected": "Neither host can be made to use the other's channel, and faking symmetry would report a comparison that was never run."
    },
    {
      "confound": "prompt length",
      "detail": "CANDIDATE_V2_1 is 36,866 bytes against CURRENT_REPOSITORY_PROMPT's 4,663. Carried through an instruction prefix on Codex, that length competes with the task itself rather than sitting in a separate channel.",
      "how_to_separate": "a length-matched fourth arm, which this preregistration does not freeze",
      "why_not_corrected": "Truncating the candidate would no longer test the candidate."
    },
    {
      "confound": "usage reporting",
      "detail": "Claude Code reports token counts and cost; Codex CLI reports neither in a machine-readable form. Cost cannot be compared across stacks and is recorded as unobserved rather than as zero.",
      "how_to_separate": "provider billing export",
      "why_not_corrected": "outside this harness"
    }
  ],
