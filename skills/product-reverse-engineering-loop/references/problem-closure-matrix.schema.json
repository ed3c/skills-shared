{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prel-problem-closure-matrix.schema.json",
  "title": "PREL problem closure matrix",
  "description": "One row per requirement or mechanism hypothesis the dossier put in scope. A row closes only through an oracle in the row's own lane; a technical lane can never close a user or paid lane, and a row with no oracle is BLOCKED_NO_ORACLE rather than open work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "derived_from", "rows", "evidence_ceiling"],
  "properties": {
    "schema": {"const": "prel/problem-closure-matrix/v1"},
    "subject": {"$ref": "#/$defs/subject"},
    "derived_from": {"$ref": "#/$defs/derived_from"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    },
    "evidence_ceiling": {"$ref": "#/$defs/evidence_ceiling"}
  },
  "$defs": {
    "state": {
      "enum": [
        "PASS",
        "FAIL",
        "ABSENT",
        "NOT_IMPLEMENTED",
        "NOT_EXERCISED",
        "SKIPPED_BY_POLICY",
        "HUMAN_ADMIT_REQUIRED"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "surface", "captured_at", "subject_digest"],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "minLength": 10},
        "subject_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "digest"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "requirement", "lane", "oracle_id", "oracle_lane", "closure_state", "evidence_state", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^CLR-[0-9]{3}$"},
        "source_id": {"type": "string", "minLength": 4},
        "requirement": {"type": "string", "minLength": 12},
        "lane": {"enum": ["DETERMINISTIC", "BEHAVIORAL", "USER", "PAID", "HUMAN_ADMIT"]},
        "oracle_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^ORC-[0-9]{3}$"}]},
        "oracle_lane": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["DETERMINISTIC", "BEHAVIORAL", "USER", "PAID", "HUMAN_ADMIT"]}
          ]
        },
        "closure_state": {
          "enum": [
            "CLOSED_BY_ORACLE",
            "OPEN_WITH_ORACLE",
            "BLOCKED_NO_ORACLE",
            "BLOCKED_NOT_FALSIFIABLE",
            "BLOCKED_LANE_MISMATCH",
            "OUT_OF_SCOPE",
            "HUMAN_ADMIT_REQUIRED"
          ]
        },
        "evidence_state": {"$ref": "#/$defs/state"},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "evidence_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portable_procedure",
        "deterministic_contract",
        "product_market_fit",
        "live_provider_execution",
        "production_readiness"
      ],
      "properties": {
        "portable_procedure": {"$ref": "#/$defs/state"},
        "deterministic_contract": {"$ref": "#/$defs/state"},
        "product_market_fit": {"$ref": "#/$defs/state"},
        "live_provider_execution": {"$ref": "#/$defs/state"},
        "production_readiness": {"$ref": "#/$defs/state"}
      }
    }
  }
}
