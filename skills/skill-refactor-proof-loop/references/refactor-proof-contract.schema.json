{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refactor-proof-loop/refactor-proof-contract/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proof_id",
    "owner_skill",
    "source",
    "treatments",
    "protected_strengths",
    "proof_layers",
    "matched_task",
    "denominator_policy",
    "cleanup",
    "authority",
    "evidence",
    "remaining_issues"
  ],
  "properties": {
    "schema": {
      "const": "skill-refactor-proof-loop/refactor-proof-contract/v1"
    },
    "proof_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "owner_skill": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "pull_requests"
      ],
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "pull_requests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "treatments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "path",
          "blob_sha",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "OLD_CANONICAL",
              "REFACTOR_AS_LANDED",
              "REPAIRED_CANDIDATE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "state": {
            "enum": [
              "FROZEN",
              "CURRENT_CANDIDATE"
            ]
          }
        }
      }
    },
    "protected_strengths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "old_evidence",
          "new_assertion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "old_evidence": {
            "type": "string",
            "minLength": 1
          },
          "new_assertion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proof_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "L0_SOURCE_FREEZE",
        "L1_STRUCTURAL_REACHABILITY",
        "L2_EXECUTABLE_CONTRACT",
        "L3_HERMETIC_REAL_TASK",
        "L4_MATCHED_LIVE_MODEL_RUNTIME",
        "L5_DELIVERY_AND_HUMAN_ADMIT"
      ],
      "properties": {
        "L0_SOURCE_FREEZE": {
          "enum": [
            "PASS",
            "FAIL",
            "ABSENT",
            "NOT_IMPLEMENTED",
            "NOT_EXERCISED",
            "HUMAN_ADMIT_REQUIRED"
          ]
        },
        "L1_STRUCTURAL_REACHABILITY": {
          "enum": [
            "PASS",
            "FAIL",
            "ABSENT",
            "NOT_IMPLEMENTED",
            "NOT_EXERCISED",
            "HUMAN_ADMIT_REQUIRED"
          ]
        },
        "L2_EXECUTABLE_CONTRACT": {
          "enum": [
            "PASS",
            "FAIL",
            "ABSENT",
            "NOT_IMPLEMENTED",
            "NOT_EXERCISED",
            "HUMAN_ADMIT_REQUIRED"
          ]
        },
        "L3_HERMETIC_REAL_TASK": {
          "enum": [
            "PASS",
            "FAIL",
            "ABSENT",
            "NOT_IMPLEMENTED",
            "NOT_EXERCISED",
            "HUMAN_ADMIT_REQUIRED"
          ]
        },
        "L4_MATCHED_LIVE_MODEL_RUNTIME": {
          "enum": [
            "PASS",
            "FAIL",
            "ABSENT",
            "NOT_IMPLEMENTED",
            "NOT_EXERCISED",
            "HUMAN_ADMIT_REQUIRED"
          ]
        },
        "L5_DELIVERY_AND_HUMAN_ADMIT": {
          "enum": [
            "PASS",
            "FAIL",
            "ABSENT",
            "NOT_IMPLEMENTED",
            "NOT_EXERCISED",
            "HUMAN_ADMIT_REQUIRED"
          ]
        }
      }
    },
    "matched_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "same_base_tree",
        "same_contracts_tests",
        "same_budget",
        "same_carrier",
        "global_objective"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "same_base_tree": {
          "type": "boolean"
        },
        "same_contracts_tests": {
          "type": "boolean"
        },
        "same_budget": {
          "type": "boolean"
        },
        "same_carrier": {
          "type": "boolean"
        },
        "global_objective": {
          "type": "boolean"
        }
      }
    },
    "denominator_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failed_retained",
        "stale_retained",
        "blocked_retained",
        "cancelled_retained",
        "superseded_retained"
      ],
      "properties": {
        "failed_retained": {
          "type": "boolean"
        },
        "stale_retained": {
          "type": "boolean"
        },
        "blocked_retained": {
          "type": "boolean"
        },
        "cancelled_retained": {
          "type": "boolean"
        },
        "superseded_retained": {
          "type": "boolean"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processes",
        "worktrees",
        "branches",
        "leases",
        "temporary_state"
      ],
      "properties": {
        "processes": {
          "enum": [
            "CLEAN",
            "NOT_EXERCISED"
          ]
        },
        "worktrees": {
          "enum": [
            "CLEAN",
            "NOT_EXERCISED"
          ]
        },
        "branches": {
          "enum": [
            "CLEAN",
            "NOT_EXERCISED"
          ]
        },
        "leases": {
          "enum": [
            "CLEAN",
            "NOT_EXERCISED"
          ]
        },
        "temporary_state": {
          "enum": [
            "CLEAN",
            "NOT_EXERCISED"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_activation",
        "publication",
        "semantic_conflict_resolution",
        "merge",
        "release",
        "promotion",
        "rollback"
      ],
      "properties": {
        "provider_activation": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "semantic_conflict_resolution": {
          "const": false
        },
        "merge": {
          "const": false
        },
        "release": {
          "const": false
        },
        "promotion": {
          "const": false
        },
        "rollback": {
          "const": false
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_runtime_receipts",
        "delivery_receipts",
        "human_admit_receipts"
      ],
      "properties": {
        "live_runtime_receipts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delivery_receipts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_admit_receipts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "remaining_issues": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    }
  }
}
