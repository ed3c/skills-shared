{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-refactor-proof-loop/refactor-proof-stack/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stack_id",
    "owner_skill",
    "epic_issue",
    "convergence_owner",
    "nodes",
    "edges",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "skill-refactor-proof-loop/refactor-proof-stack/v1"
    },
    "stack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "owner_skill": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "epic_issue": {
      "type": "integer",
      "minimum": 1
    },
    "convergence_owner": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stack_class",
          "issues",
          "pull_request",
          "branch",
          "base_branch",
          "state",
          "owns_paths",
          "consumes_artifacts",
          "provides_artifacts",
          "evals",
          "negative_controls",
          "workflow",
          "head",
          "terminal_classification",
          "remaining_evidence",
          "rollback",
          "human_admit",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "stack_class": {
            "enum": [
              "ROOT",
              "TRUE_CHILD",
              "SIBLING",
              "CONVERGENCE",
              "PLANNED_FOLLOWUP",
              "EXTERNAL_EVIDENCE"
            ]
          },
          "issues": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "pull_request": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "base_branch": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "state": {
            "enum": [
              "PLANNED",
              "BRANCH_CREATED",
              "PR_DRAFT",
              "PR_OPEN",
              "BLOCKED",
              "READY_FOR_HUMAN_ADMIT",
              "MERGED",
              "CLOSED_NOT_PLANNED",
              "EXTERNAL_OPEN"
            ]
          },
          "owns_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consumes_artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "provides_artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "negative_controls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "workflow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "source"
            ],
            "properties": {
              "state": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "IN_PROGRESS",
                  "NOT_EXERCISED",
                  "READ_FROM_GITHUB",
                  "SKIPPED_BY_POLICY",
                  "HUMAN_ADMIT_REQUIRED"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "head": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy",
              "observed_sha"
            ],
            "properties": {
              "policy": {
                "enum": [
                  "READ_FROM_GITHUB_PR_METADATA",
                  "IMMUTABLE_MERGED_COMMIT",
                  "NOT_APPLICABLE"
                ]
              },
              "observed_sha": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "terminal_classification": {
            "enum": [
              "IMPLEMENTED_PENDING_HUMAN",
              "PARTIAL",
              "BLOCKED",
              "PLANNED",
              "EXTERNAL_OPEN",
              "MERGED",
              "CLOSED_NOT_PLANNED"
            ]
          },
          "remaining_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          },
          "human_admit": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "auto_resolve_semantic_conflict",
              "force_push",
              "ship",
              "merge",
              "release",
              "promotion"
            ],
            "properties": {
              "auto_resolve_semantic_conflict": {
                "const": false
              },
              "force_push": {
                "const": false
              },
              "ship": {
                "const": false
              },
              "merge": {
                "const": false
              },
              "release": {
                "const": false
              },
              "promotion": {
                "const": false
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type",
          "artifacts",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "CONSUMES_UNMERGED_BYTES",
              "CONVERGES_VERIFIED_ARTIFACTS",
              "EXTERNAL_EVIDENCE",
              "PROCESS_DEPENDENCY",
              "SIBLING_RELATION"
            ]
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_resolve_semantic_conflict",
        "force_push",
        "ship",
        "merge",
        "release",
        "promotion"
      ],
      "properties": {
        "auto_resolve_semantic_conflict": {
          "const": false
        },
        "force_push": {
          "const": false
        },
        "ship": {
          "const": false
        },
        "merge": {
          "const": false
        },
        "release": {
          "const": false
        },
        "promotion": {
          "const": false
        }
      }
    }
  }
}
