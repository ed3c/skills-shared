{
  "schema_version": "git-town-tech-lead-fanout/v1",
  "repository": "example/monorepo",
  "mode": "TOURNAMENT",
  "base": {
    "branch": "main",
    "commit_sha": "1111111111111111111111111111111111111111",
    "tree_sha": "2222222222222222222222222222222222222222",
    "immutable": true
  },
  "context_bundle": {
    "digest": "3333333333333333333333333333333333333333333333333333333333333333",
    "providers": [
      {"name": "grepai", "role": "intent-discovery", "required_provider": false, "state": "NOT_EXERCISED"},
      {"name": "source-readback", "role": "source-readback", "required_provider": true, "state": "PASS"}
    ],
    "compiler_truth_funnel": {"state": "NOT_EXERCISED"}
  },
  "budgets": {
    "max_workers": 3,
    "max_tokens_per_worker": 250000,
    "max_wall_clock_seconds": 5400,
    "max_retries_per_worker": 2,
    "circuit_breakers": [
      "stop the fan-out after three consecutive Worker failures against the same acceptance oracle",
      "stop a Worker when its token budget is spent, without a silent extension"
    ]
  },
  "acceptance": {
    "immutable_paths": ["tests/acceptance/**"],
    "oracles": ["bash tests/acceptance/verify.sh"]
  },
  "ranking": {
    "hard_gates": [
      "bash tests/acceptance/verify.sh exits 0",
      "no file under tests/acceptance changed",
      "diff touches only the declared writable lease"
    ],
    "qualitative_review_after_hard_gates": true,
    "winner_admission": "human",
    "cross_competitor_cherry_pick": false
  },
  "semantic_conflict_resolution": "human",
  "human_owned_operations": [
    "semantic_conflict_resolution",
    "winner_admission",
    "merge_or_ship",
    "release_promotion"
  ],
  "workers": [
    {
      "id": "T-minimal",
      "branch": "agent/rate-limit-minimal",
      "role": "competitor",
      "parent": "main",
      "depends_on": [],
      "focus": "minimal-diff",
      "writable_paths": ["src/ratelimit/**"],
      "read_only_paths": ["tests/acceptance/**", "docs/**"],
      "provides_contracts": ["rate-limit-v1"],
      "context_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "token_budget": 180000
    },
    {
      "id": "T-types",
      "branch": "agent/rate-limit-types",
      "role": "competitor",
      "parent": "main",
      "depends_on": [],
      "focus": "architecture-types",
      "writable_paths": ["src/ratelimit/**"],
      "read_only_paths": ["tests/acceptance/**", "docs/**"],
      "provides_contracts": ["rate-limit-v1"],
      "context_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "token_budget": 250000
    },
    {
      "id": "T-boundaries",
      "branch": "agent/rate-limit-boundaries",
      "role": "competitor",
      "parent": "main",
      "depends_on": [],
      "focus": "defensive-boundaries",
      "writable_paths": ["src/ratelimit/**"],
      "read_only_paths": ["tests/acceptance/**", "docs/**"],
      "provides_contracts": ["rate-limit-v1"],
      "context_digest": "3333333333333333333333333333333333333333333333333333333333333333",
      "token_budget": 220000
    }
  ]
}
