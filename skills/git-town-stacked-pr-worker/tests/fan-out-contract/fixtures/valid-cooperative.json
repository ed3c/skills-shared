{
  "schema_version": "git-town-tech-lead-fanout/v1",
  "repository": "example/monorepo",
  "mode": "COOPERATIVE",
  "base": {
    "branch": "main",
    "commit_sha": "4444444444444444444444444444444444444444",
    "tree_sha": "5555555555555555555555555555555555555555",
    "immutable": true
  },
  "context_bundle": {
    "digest": "6666666666666666666666666666666666666666666666666666666666666666",
    "providers": [
      {"name": "source-readback", "role": "source-readback", "required_provider": true, "state": "PASS"}
    ],
    "compiler_truth_funnel": {"state": "NOT_EXERCISED"}
  },
  "budgets": {
    "max_workers": 3,
    "max_tokens_per_worker": 200000,
    "max_wall_clock_seconds": 3600,
    "max_retries_per_worker": 1,
    "circuit_breakers": [
      "stop a Worker that writes outside its lease instead of widening the lease"
    ]
  },
  "acceptance": {
    "immutable_paths": ["tests/acceptance/**"],
    "oracles": ["bash tests/acceptance/verify.sh"]
  },
  "ranking": {
    "hard_gates": ["bash tests/acceptance/verify.sh exits 0 on the converged tree"],
    "qualitative_review_after_hard_gates": true,
    "winner_admission": "human",
    "cross_competitor_cherry_pick": false
  },
  "semantic_conflict_resolution": "human",
  "human_owned_operations": [
    "semantic_conflict_resolution",
    "winner_admission",
    "merge_or_ship",
    "release_promotion"
  ],
  "convergence": {
    "owner_worker_id": "C-index",
    "inputs": ["C-storage", "C-api"]
  },
  "workers": [
    {
      "id": "C-storage",
      "branch": "agent/storage-layer",
      "role": "sibling",
      "parent": "main",
      "depends_on": [],
      "writable_paths": ["src/storage/**"],
      "read_only_paths": ["src/api/**", "tests/acceptance/**"],
      "provides_contracts": ["storage-v2"],
      "token_budget": 150000
    },
    {
      "id": "C-api",
      "branch": "agent/api-surface",
      "role": "sibling",
      "parent": "main",
      "depends_on": [],
      "writable_paths": ["src/api/**"],
      "read_only_paths": ["src/storage/**", "tests/acceptance/**"],
      "provides_contracts": ["api-v3"],
      "token_budget": 150000
    },
    {
      "id": "C-index",
      "branch": "agent/converge-indexes",
      "role": "convergence",
      "parent": "main",
      "depends_on": ["C-storage", "C-api"],
      "writable_paths": ["docs/INDEX.md", "README.md"],
      "read_only_paths": ["src/**"],
      "consumes_contracts": ["storage-v2", "api-v3"],
      "token_budget": 60000
    }
  ]
}
