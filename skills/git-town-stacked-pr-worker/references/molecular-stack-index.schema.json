{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/skills/git-town-stacked-pr-worker/references/molecular-stack-index.schema.json",
  "title": "Molecular Stack Index",
  "description": "Deterministic index of the atoms in one Stack: C contract, K deterministic core, A adapter/substrate, E controls, X explicit convergence, D documentation/receipt. Shape gate only; assert_molecular_stack_index.py owns the semantic laws.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "main_branch", "required_atoms", "convergence_owner", "atoms"],
  "properties": {
    "schema_version": {"const": "git-town/molecular-stack-index/v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "main_branch": {"type": "string", "minLength": 1},
    "required_atoms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["C", "K", "A", "E", "X", "D"]}
    },
    "convergence_owner": {"type": "string", "minLength": 1},
    "atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "atom",
          "purpose",
          "stack_class",
          "lane",
          "branch",
          "base_branch",
          "parents",
          "owns_paths",
          "consumes_paths",
          "oracle",
          "gates",
          "blockers",
          "writer_lease",
          "pr"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "atom": {"enum": ["C", "K", "A", "E", "X", "D"]},
          "purpose": {"type": "string"},
          "stack_class": {"enum": ["root", "sibling", "child", "review-only", "convergence"]},
          "lane": {"enum": ["CLOUD", "LOCAL", "PRIVATE", "HUMAN"]},
          "branch": {"type": "string", "minLength": 1},
          "base_branch": {"type": "string", "minLength": 1},
          "parents": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "owns_paths": {"type": "array", "items": {"type": "string"}},
          "consumes_paths": {"type": "array", "items": {"type": "string"}},
          "oracle": {"type": "string"},
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "required_lane", "receipt_lane"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "required_lane": {"enum": ["CLOUD", "LOCAL", "PRIVATE", "HUMAN"]},
                "receipt_lane": {"enum": ["CLOUD", "LOCAL", "PRIVATE", "HUMAN", null]}
              }
            }
          },
          "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "writer_lease": {"type": "string"},
          "pr": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "head_sha", "head_source"],
            "properties": {
              "state": {"enum": ["NOT_CREATED", "DRAFT", "READY", "MERGED"]},
              "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
              "head_source": {"enum": ["ABSENT", "LIVE_PROVIDER", "IMMUTABLE_MERGED"]}
            }
          }
        }
      }
    }
  }
}
