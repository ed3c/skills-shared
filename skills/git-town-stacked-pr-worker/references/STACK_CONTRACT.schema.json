{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/skills/git-town-stacked-pr-worker/references/STACK_CONTRACT.schema.json",
  "title": "Git Town Intent-Bound Stack Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "main_branch",
    "subject_identity",
    "human_owned_operations",
    "branches",
    "convergence_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "git-town-intent-stack/v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "main_branch": {
      "type": "string",
      "minLength": 1
    },
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "human_owned_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/branch"
      }
    },
    "convergence_plan": {
      "$ref": "#/$defs/convergence"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "branch",
        "pr_number",
        "stack_class",
        "parent_branch",
        "pr_base",
        "head_sha",
        "declared_parent_head_sha",
        "observed_parent_head_sha",
        "merge_base_sha",
        "ahead_by",
        "behind_by",
        "consumes_contracts",
        "consumes_paths",
        "provides_contracts",
        "dependency_reason",
        "depends_on_branches",
        "allowed_paths",
        "excluded_paths",
        "evidence_subject_sha",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^STACK-[A-Z0-9-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "stack_class": {
          "enum": [
            "foundation",
            "child",
            "sibling",
            "hotfix"
          ]
        },
        "parent_branch": {
          "type": "string",
          "minLength": 1
        },
        "pr_base": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "declared_parent_head_sha": {
          "$ref": "#/$defs/sha"
        },
        "observed_parent_head_sha": {
          "$ref": "#/$defs/sha"
        },
        "merge_base_sha": {
          "$ref": "#/$defs/sha"
        },
        "ahead_by": {
          "type": "integer",
          "minimum": 1
        },
        "behind_by": {
          "type": "integer",
          "minimum": 0
        },
        "consumes_contracts": {
          "$ref": "#/$defs/strings"
        },
        "provides_contracts": {
          "$ref": "#/$defs/strings"
        },
        "dependency_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "depends_on_branches": {
          "$ref": "#/$defs/strings"
        },
        "allowed_paths": {
          "$ref": "#/$defs/strings"
        },
        "excluded_paths": {
          "$ref": "#/$defs/strings"
        },
        "evidence_subject_sha": {
          "$ref": "#/$defs/sha"
        },
        "state": {
          "enum": [
            "ACTIVE",
            "BLOCKED",
            "ADMITTED"
          ]
        },
        "consumes_paths": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_issue",
        "branch",
        "state",
        "prerequisites"
      ],
      "properties": {
        "owner_issue": {
          "type": "integer",
          "minimum": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "NOT_CREATED",
            "READY",
            "CREATED",
            "ADMITTED"
          ]
        },
        "prerequisites": {
          "$ref": "#/$defs/strings"
        }
      }
    }
  }
}
