{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/skills/universal-refactor-controller/evals/canaries/golden-refactor-corpus.schema.json",
  "title": "UCR Golden Refactor Corpus Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_boundary", "cases"],
  "properties": {
    "schema_version": {"const": "universal-refactor/golden-refactor-corpus/v1"},
    "evidence_boundary": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target_kind",
          "repository",
          "baseline",
          "issue_refs",
          "pull_request_refs",
          "verification",
          "complexity_delta",
          "promotion_state",
          "unproven_claims"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "target_kind": {"enum": ["SKILL", "REPOSITORY"]},
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commit", "tree"],
            "properties": {
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          },
          "issue_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[^/]+/[^#]+#[0-9]+$"}
          },
          "pull_request_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[^/]+/[^#]+#[0-9]+$"}
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lane", "workflow_run_ids", "state"],
            "properties": {
              "lane": {"enum": ["REMOTE_SKILL_SUITE_VERIFIED", "REMOTE_REPOSITORY_VERIFIED"]},
              "workflow_run_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 1}
              },
              "state": {"const": "PASS"}
            }
          },
          "complexity_delta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "before", "after", "protected_non_regression"],
            "properties": {
              "dimension": {"type": "string", "minLength": 1},
              "before": {"type": "number", "minimum": 0},
              "after": {"type": "number", "minimum": 0},
              "protected_non_regression": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "promotion_state": {"enum": ["HOLD_UNMERGED", "GOLDEN_ELIGIBLE", "GOLDEN_PROMOTED"]},
          "unproven_claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
