{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/skills-shared/human-led-agentic-engineering/design-admission.schema.json",
  "title": "Human Design Admission Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "subject",
    "problem_statement_digest",
    "design_digest",
    "human_actor",
    "admitted_at",
    "adversary_receipt_digest",
    "material_decisions",
    "non_goals",
    "disposition"
  ],
  "properties": {
    "schema_version": { "const": "human-design-admission/v1" },
    "repository": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "problem_statement_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "design_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "human_actor": { "type": "string", "minLength": 1 },
    "admitted_at": { "type": "string", "format": "date-time" },
    "adversary_receipt_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "material_decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_dissent": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "human_disposition"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "human_disposition": { "type": "string", "minLength": 1 }
        }
      },
      "default": []
    },
    "disposition": { "const": "HUMAN_DESIGN_ADMITTED" }
  }
}
