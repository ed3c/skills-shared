{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.dev/contracts/subagent-result/v1",
  "title": "Codex Subagent Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dispatch_digest", "state", "observed_base", "result_subject", "changed_paths", "commands", "lease_readback", "findings", "output_digests", "cleanup", "claims_not_proven", "digest"],
  "properties": {
    "schema": {"const": "subagent-result/v1"},
    "dispatch_digest": {"$ref": "#/$defs/sha256"},
    "state": {"enum": ["PASS", "FAIL", "BLOCKED", "CANCELLED", "STALE", "ABSENT", "TIMEOUT"]},
    "observed_base": {"$ref": "#/$defs/subject"},
    "result_subject": {"$ref": "#/$defs/subject"},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "exit_code", "stdout_digest", "stderr_digest"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "stdout_digest": {"$ref": "#/$defs/sha256"},
          "stderr_digest": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "lease_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusive_paths_respected", "forbidden_paths_untouched", "dirty_state"],
      "properties": {
        "exclusive_paths_respected": {"type": "boolean"},
        "forbidden_paths_untouched": {"type": "boolean"},
        "dirty_state": {"enum": ["CLEAN", "DECLARED_CHANGES_ONLY", "UNDECLARED_RESIDUE"]}
      }
    },
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_digests": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processes", "worktree", "leases", "residue"],
      "properties": {
        "processes": {"enum": ["CLEAN", "RESIDUE", "NOT_APPLICABLE"]},
        "worktree": {"enum": ["CLEAN", "PRESERVED_WITH_OWNER", "RESIDUE", "NOT_APPLICABLE"]},
        "leases": {"enum": ["RELEASED", "PRESERVED_WITH_OWNER", "RESIDUE"]},
        "residue": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "claims_not_proven": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"}
      }
    }
  }
}
