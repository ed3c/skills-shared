{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.dev/contracts/repository-portfolio-snapshot/v1",
  "title": "Repository Portfolio Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "epoch_id", "observed_at", "runtime", "repositories", "digest"],
  "properties": {
    "schema": {"const": "repository-portfolio-snapshot/v1"},
    "epoch_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "host", "local_checkout", "authority_ceiling"],
      "properties": {
        "class": {"enum": ["CHATGPT_GITHUB_CONNECTOR", "GITHUB_ACTIONS", "CLAUDE_CODE_LOCAL", "CODEX_CLI_LOCAL", "CHATGPT_DESKTOP_WORKTREE", "UNKNOWN"]},
        "host": {"type": "string", "minLength": 1},
        "local_checkout": {"enum": ["PASS", "ABSENT", "NOT_EXERCISED", "BLOCKED"]},
        "authority_ceiling": {"type": "string", "minLength": 1}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["full_name", "visibility", "default_branch", "main_commit", "main_tree", "issues", "pull_requests", "workflows", "path_writers"],
        "properties": {
          "full_name": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "visibility": {"enum": ["PUBLIC", "PRIVATE", "INTERNAL", "UNKNOWN"]},
          "default_branch": {"type": "string", "minLength": 1},
          "main_commit": {"$ref": "#/$defs/sha1"},
          "main_tree": {"$ref": "#/$defs/sha1"},
          "issues": {"type": "array", "items": {"$ref": "#/$defs/item"}},
          "pull_requests": {"type": "array", "items": {"$ref": "#/$defs/item"}},
          "workflows": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "path_writers": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "state", "updated_at"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "state": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date-time"},
        "base_commit": {"$ref": "#/$defs/sha1"},
        "head_commit": {"$ref": "#/$defs/sha1"},
        "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
