{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/skills/agentic-tech-lead-orchestration/codex-live-acceptance-receipt-v2.schema.json",
  "title": "Codex Live Acceptance Receipt v2",
  "description": "Live Codex execution candidate whose claimed changed-file denominator has been independently read back from an immutable post-turn Git tree, and whose result tree has been replayed offline from a durable carrier (#508). The v1 schema remains historical for pre-#505 receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","task_id","attempt_id","repo","base_sha","base_tree_sha","tree_sha","prompt_digest","worker_result_sha256","changed_files","controller_commands","sdk_execution","lease_readback","result_tree_readback","result_tree_replay","result_carrier","executor_identity","source_diff_readback","tests_readback","acceptance_state","shadow_review_required","evidence_ceiling"],
  "properties": {
    "schema_version": {"const": 2},
    "schema": {"const": "agentic-tech-lead/codex-live-acceptance/v2"},
    "task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prompt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "worker_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changed_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "controller_commands": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["command_sha256","exit_code","output_sha256"], "properties": {"command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "exit_code": {"const": 0}, "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "sdk_execution": {"const": "EXERCISED"},
    "lease_readback": {"const": "PASS"},
    "result_tree_readback": {"const": "PASS"},
    "result_tree_replay": {"const": "PASS", "description": "The result tree was resolved from carrier bundle + manifest alone, in a scratch repository with no access to the originating object store."},
    "result_carrier": {"type": "object", "additionalProperties": false, "required": ["carrier_kind","carrier_id","result_ref","bundle_filename","bundle_sha256","bundle_bytes"], "properties": {"carrier_kind": {"const": "GIT_BUNDLE_V2"}, "carrier_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "result_ref": {"type": "string", "pattern": "^refs/evidence/codex-v2/[A-Za-z0-9._-]+/result$"}, "bundle_filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.bundle$"}, "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bundle_bytes": {"type": "integer", "minimum": 1}}},
    "executor_identity": {"type": "object", "additionalProperties": false, "required": ["adapter_version","adapter_blob_sha256","sdk_package","sdk_version","codex_binary_source","codex_binary_sha256"], "properties": {"adapter_version": {"type": "string", "minLength": 1}, "adapter_blob_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sdk_package": {"type": "string", "minLength": 1}, "sdk_version": {"type": "string", "minLength": 1}, "codex_binary_source": {"enum": ["SDK_PINNED_RUNTIME","SDK_BUNDLED","PATH","ABSENT"]}, "codex_binary_sha256": {"type": ["string","null"], "pattern": "^[0-9a-f]{64}$"}}},
    "source_diff_readback": {"const": "PASS"},
    "tests_readback": {"const": "PASS"},
    "acceptance_state": {"const": "LIVE_RUNTIME_AND_CONTROLLER_READBACK_CANDIDATE"},
    "shadow_review_required": {"const": true},
    "evidence_ceiling": {"const": "LIVE_EXECUTION_OBSERVED_SHADOW_PENDING"}
  }
}
