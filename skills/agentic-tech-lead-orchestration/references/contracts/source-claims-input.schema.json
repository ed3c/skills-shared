{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/skills/agentic-tech-lead-orchestration/source-claims-input.schema.json",
  "title": "Source Claims Compiler Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","repo_subject","claims"],
  "properties": {
    "schema_version": {"const": 1},
    "repo_subject": {"$ref": "#/$defs/subject"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo","commit","tree"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id","attempt_id","worktree"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "pattern": "^[A-Za-z0-9_.:@-]+$"},
        "thread_id": {"type": ["string","null"], "minLength": 1}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","subject","repo_subject","status"],
      "properties": {
        "kind": {"enum": ["COMMIT","PR","MERGE_SUBJECT","SOURCE_DIFF","GENERATED_ARTIFACT"]},
        "subject": {"type": "string", "minLength": 1},
        "repo_subject": {"$ref": "#/$defs/subject"},
        "status": {"enum": ["CURRENT","HISTORICAL","SUPERSEDED"]}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_id","kind","identity","location","claim","applicability","task_nodes","dag_nodes","issue_nodes"],
      "properties": {
        "problem_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["GITHUB_ISSUE","ARTICLE","PDF","PRD"]},
        "identity": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "claim_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "applicability": {"enum": ["APPLICABLE","NOT_APPLICABLE","SUPERSEDED"]},
        "applicability_rationale": {"type": "string", "minLength": 1},
        "superseded_by": {"type": "string", "minLength": 1},
        "requires_human": {"type": "boolean"},
        "task_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dag_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "issue_nodes": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "session_attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
        "implementation_evidence": {"type": "array", "items": {"$ref": "#/$defs/implementation"}}
      }
    }
  }
}
