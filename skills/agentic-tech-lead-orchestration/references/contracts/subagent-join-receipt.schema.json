{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.dev/contracts/subagent-join-receipt/v1",
  "title": "Subagent Join Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "epoch_digest", "required_dispatch_digests", "results", "missing", "contradictions", "dissent", "verdict", "consolidated_findings_digest", "claims_not_proven", "digest"],
  "properties": {
    "schema": {"const": "subagent-join-receipt/v1"},
    "epoch_digest": {"$ref": "#/$defs/sha256"},
    "required_dispatch_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dispatch_digest", "result_digest", "state"],
        "properties": {
          "dispatch_digest": {"$ref": "#/$defs/sha256"},
          "result_digest": {"$ref": "#/$defs/sha256"},
          "state": {"enum": ["PASS", "FAIL", "BLOCKED", "CANCELLED", "STALE", "ABSENT", "TIMEOUT"]}
        }
      }
    },
    "missing": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "contradictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dissent": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verdict": {"enum": ["PASS", "JOIN_INCOMPLETE", "REJECT"]},
    "consolidated_findings_digest": {"$ref": "#/$defs/sha256"},
    "claims_not_proven": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
