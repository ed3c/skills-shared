{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.dev/contracts/issue-pr-acceptance/v1",
  "title": "Issue or PR Acceptance Contract",
  "description": "Merged from PR#564 (efb224d, field/shape base) and PR#562 (caedeb9, dependency edge typing). #566 mandatory fix 4: start_dependencies/completion_dependencies are typed {unit_id, subject_digest, reason} edges, not PR#564's original bare-string arrays -- a bare unit_id string cannot carry the exact subject a dependency was admitted against, so a moved/rewritten parent could silently keep satisfying a stale dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "epoch_id",
    "repository",
    "item",
    "objective",
    "non_goals",
    "start_dependencies",
    "completion_dependencies",
    "leases",
    "runtime_requirements",
    "oracles",
    "negative_controls",
    "evidence",
    "rollback",
    "allowed_terminal_states",
    "residual_owner",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "agentic-tech-lead/issue-pr-acceptance/v1"},
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "description": "Graph-node identity. PR#564's original schema had no primary key at all (identified an item only by repository+kind+number), which the multigraph compiler cannot use as a dependency reference target -- added here as the minimal necessary field."
    },
    "epoch_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "number", "observed_state"],
      "properties": {
        "kind": {"enum": ["ISSUE", "PULL_REQUEST"]},
        "number": {"type": "integer", "minimum": 1},
        "observed_state": {"type": "string", "minLength": 1},
        "base_commit": {"$ref": "#/$defs/sha1"},
        "base_tree": {"$ref": "#/$defs/sha1"},
        "head_commit": {"$ref": "#/$defs/sha1"},
        "head_tree": {"$ref": "#/$defs/sha1"},
        "main_readback_commit": {
          "$ref": "#/$defs/sha1",
          "description": "For a MERGED PULL_REQUEST: the exact commit read back from the default branch after merge. Required to equal head_commit -- absence or drift is MERGED_WITHOUT_EXACT_MAIN_READBACK."
        }
      }
    },
    "objective": {"type": "string", "minLength": 20},
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "start_dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dependency"}},
    "completion_dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dependency"}},
    "leases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusive_paths", "read_only_paths", "forbidden_paths", "exclusive_resources"],
      "properties": {
        "exclusive_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "read_only_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exclusive_resources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "runtime_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "state", "owner", "unblock_condition"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "state": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_IMPLEMENTED", "NOT_EXERCISED", "SKIPPED_BY_POLICY", "BLOCKED", "HUMAN_ADMIT_REQUIRED"]},
          "owner": {"type": "string", "minLength": 1},
          "unblock_condition": {"type": "string", "minLength": 1}
        }
      }
    },
    "oracles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "negative_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_lanes", "ceiling"],
      "properties": {
        "required_lanes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SOURCE", "DETERMINISTIC", "LOCAL", "HOSTED_CI", "PROVIDER", "PRIVATE", "HUMAN", "PRODUCTION"]}},
        "ceiling": {"type": "string", "minLength": 1}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "strategy"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"},
        "strategy": {"type": "string", "minLength": 3}
      }
    },
    "allowed_terminal_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "residual_owner": {"type": "string", "minLength": 1},
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "subject_digest", "reason"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "subject_digest": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
