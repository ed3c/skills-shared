{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/skills/agentic-tech-lead-orchestration/herdr-observer-receipt.schema.json",
  "title": "Herdr Runtime Observer Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "attempt_id", "repo", "base_sha", "tree_sha",
    "worktree", "target", "observer_state", "herdr_available", "authoritative",
    "controller_readback_required", "evidence_ceiling"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktree": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "pane_id": {"type": ["string", "null"]},
    "workspace_id": {"type": ["string", "null"]},
    "process_id": {"type": ["string", "integer", "null"]},
    "process_started_at_unix": {"type": ["integer", "null"], "minimum": 1},
    "process_alive": {"type": ["boolean", "null"]},
    "agent_session_id": {"type": ["string", "null"]},
    "agent_session_source": {"type": ["string", "null"]},
    "foreground_cwd": {"type": ["string", "null"]},
    "state_change_seq": {"type": "integer", "minimum": 0},
    "observation_time_source": {"enum": ["HERDR_SOURCE_CLOCK", "OBSERVER_LOCAL_CLOCK"]},
    "process_facts_source": {"enum": ["HERDR_AGENT_SURFACE", "HERDR_PANE_PROCESS_INFO_PLUS_OS_PS", "NOT_OBSERVED"]},
    "cleanup_source": {"enum": ["HERDR_PUBLISHED", "OBSERVER_DERIVED_PANE_PROCESS_INFO", "NOT_OBSERVED"]},
    "source_observed_at_unix": {"type": "integer", "minimum": 1},
    "observed_at_unix": {"type": "integer", "minimum": 1},
    "observation_age_seconds": {"type": "integer", "minimum": 0},
    "cleanup_state": {"type": ["string", "null"], "enum": ["CLEAN", "DIRTY", "NOT_APPLICABLE", null]},
    "residue_count": {"type": ["integer", "null"], "minimum": 0},
    "raw_state": {"type": "string"},
    "observer_state": {"enum": ["RUNNING", "BLOCKED", "IDLE", "DONE_CANDIDATE", "UNKNOWN", "UNAVAILABLE_FALLBACK"]},
    "herdr_available": {"type": "boolean"},
    "authoritative": {"const": false},
    "controller_readback_required": {"const": true},
    "evidence_ceiling": {"enum": ["NO_HERDR_OBSERVATION", "OBSERVER_IDENTITY_FRESHNESS_CLEANUP_ONLY", "OBSERVER_IDENTITY_FRESHNESS_CLEANUP_WITH_TYPED_AUXILIARY"]}
  },
  "allOf": [
    {
      "if": {"properties": {"herdr_available": {"const": true}}, "required": ["herdr_available"]},
      "then": {"required": ["state_change_seq", "observation_time_source", "process_facts_source", "cleanup_source"]}
    }
  ]
}
