{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.dev/contracts/subagent-dispatch/v1",
  "title": "Codex Subagent Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "coordinator_instruction", "dispatch_id", "epoch_digest", "task_id", "attempt_id", "role", "agent_config_digest", "host", "model", "base", "leases", "commands", "expected_outputs", "terminal_states", "budgets", "digest"],
  "properties": {
    "schema": {"const": "subagent-dispatch/v1"},
    "coordinator_instruction": {"const": "Use subagents. Wait for all agents and consolidate their findings."},
    "dispatch_id": {"type": "string", "minLength": 1},
    "epoch_digest": {"$ref": "#/$defs/sha256"},
    "task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["portfolio-explorer", "acceptance-adversary", "dependency-auditor", "runtime-admission-auditor", "implementation-worker", "consolidation-verifier", "release-auditor"]},
    "agent_config_digest": {"$ref": "#/$defs/sha256"},
    "host": {"enum": ["codex-cli", "claude-code", "chatgpt-github-connector", "github-actions", "other"]},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "provider", "carrier", "model_id", "version", "config_digest", "egress_state"],
      "properties": {
        "alias": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "carrier": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config_digest": {"$ref": "#/$defs/sha256"},
        "egress_state": {"enum": ["PASS", "ABSENT", "NOT_EXERCISED", "BLOCKED", "HUMAN_ADMIT_REQUIRED"]}
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"}
      }
    },
    "leases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusive", "read_only", "forbidden"],
      "properties": {
        "exclusive": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "read_only": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "commands": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "terminal_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PASS", "FAIL", "BLOCKED", "CANCELLED", "STALE", "ABSENT", "TIMEOUT"]}},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "max_processes", "max_output_bytes", "max_retries"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1},
        "max_processes": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1},
        "max_retries": {"type": "integer", "minimum": 0}
      }
    },
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
