    "repo": "owner/example-repo",
    "base_sha": "0123456789abcdef0123456789abcdef01234567",
    "tree_sha": "89abcdef0123456789abcdef0123456789abcdef",
    "worktree": "/worktrees/example-123",
    "target": "worker-123",
    "expected_pane_id": "w1:p2",
    "expected_workspace_id": "w1",
    "expected_agent_session_id": "codex-thread-id",
    "require_foreground_cwd": true
  },
  "authority": {
    "semantic_dag": "tech-lead-controller",
    "acceptance": "independent-controller-readback+shadow",
    "merge_release": "repository-policy/human-admit",
    "herdr": "observer-only"
  }
}
