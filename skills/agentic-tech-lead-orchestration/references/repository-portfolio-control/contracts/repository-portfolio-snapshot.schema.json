{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.dev/schemas/repository-portfolio-snapshot/v1",
  "title": "Repository Portfolio Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "epoch_id",
    "observed_at",
    "producer",
    "repositories",
    "epoch_digest",
    "evidence_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "agentic-tech-lead/repository-portfolio-snapshot/v1"
    },
    "epoch_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "required": [
        "runtime",
        "identity"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repository",
          "visibility",
          "default_branch",
          "commit",
          "tree",
          "issues_observed_at",
          "prs_observed_at",
          "workflows_observed_at"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "visibility": {
            "enum": [
              "PUBLIC",
              "PRIVATE",
              "INTERNAL"
            ]
          },
          "default_branch": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tree": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "issues_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "prs_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "workflows_observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "dirty_state": {
            "enum": [
              "CLEAN",
              "DIRTY",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "runtime_state": {
            "enum": [
              "PASS",
              "FAIL",
              "ABSENT",
              "NOT_IMPLEMENTED",
              "NOT_EXERCISED",
              "SKIPPED_BY_POLICY",
              "BLOCKED",
              "HUMAN_ADMIT_REQUIRED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "epoch_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_ceiling": {
      "const": "PROVIDER_AND_LOCAL_READBACK_ONLY"
    }
  },
  "additionalProperties": false
}
