{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.invalid/agentic-tech-lead-orchestration/issue-dual-dag.schema.json",
  "title": "Issue Dual Dependency DAG",
  "description": "One Issue graph carrying two separate edge classes: start dependencies (what must be true to begin) and completion dependencies (what must be admitted to finish). Shape gate only; assert_repository_closure_contract.py owns the semantic laws.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "convergence_owner", "nodes"],
  "properties": {
    "schema_version": {"const": "agentic-tech-lead/issue-dual-dag/v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "convergence_owner": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lane",
          "pr_state",
          "admission_state",
          "start_dependencies",
          "completion_dependencies"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "lane": {"enum": ["CLOUD", "LOCAL", "PRIVATE", "HUMAN", "PROVIDER", "PRODUCTION"]},
          "pr_state": {"enum": ["NOT_CREATED", "DRAFT", "READY", "MERGED"]},
          "admission_state": {"enum": ["NOT_ADMITTED", "ADMITTED"]},
          "start_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node", "edge_class"],
              "properties": {
                "node": {"type": "string", "minLength": 1},
                "edge_class": {"enum": ["START", "COMPLETION"]}
              }
            }
          },
          "completion_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node", "edge_class", "receipt"],
              "properties": {
                "node": {"type": "string", "minLength": 1},
                "edge_class": {"enum": ["START", "COMPLETION"]},
                "receipt": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["lane", "subject_commit", "admission_state"],
                  "properties": {
                    "lane": {"enum": ["CLOUD", "LOCAL", "PRIVATE", "HUMAN", "PROVIDER", "PRODUCTION"]},
                    "subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                    "admission_state": {"enum": ["NOT_ADMITTED", "ADMITTED"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
