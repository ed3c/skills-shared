{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-shared.invalid/agentic-tech-lead-orchestration/local-handoff-queue.schema.json",
  "title": "Local Handoff Execution Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "authority", "current", "items"],
  "properties": {
    "schema_version": {"const": "agentic-tech-lead/local-handoff-queue/v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "rollback_commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rollback_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_forbidden", "human_owned"],
      "properties": {
        "automation_forbidden": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "human_owned": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_item", "state"],
      "properties": {
        "active_item": {"type": "string", "minLength": 1},
        "state": {"const": "ACTIVE"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task_ref", "state", "entry", "runtime_lane", "receipt", "exit", "next"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "task_ref": {"type": "string", "minLength": 1},
          "state": {"enum": ["ACTIVE", "BLOCKED_BY_PREDECESSOR", "COMPLETE"]},
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["predecessor", "required_subject_commit", "required_capabilities"],
            "properties": {
              "predecessor": {"type": ["string", "null"]},
              "required_subject_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          },
          "runtime_lane": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "commands", "unresolved_operations", "live_evidence_required"],
            "properties": {
              "class": {"enum": ["LOCAL_RUNTIME", "LOCAL_PROVIDER", "LOCAL_FORGE", "LOCAL_HOST", "MIXED"]},
              "commands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["argv", "cwd", "timeout_seconds"],
                  "properties": {
                    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                    "cwd": {"type": "string", "minLength": 1},
                    "timeout_seconds": {"type": "integer", "minimum": 1},
                    "environment_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
                  }
                }
              },
              "unresolved_operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["operation_id", "resolver_source", "required_output"],
                  "properties": {
                    "operation_id": {"type": "string", "minLength": 1},
                    "resolver_source": {"type": "string", "minLength": 1},
                    "required_output": {"const": "CONCRETE_COMMAND_CONTRACT"}
                  }
                }
              },
              "live_evidence_required": {"type": "boolean"}
            }
          },
          "receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "schema", "required_states", "forbidden_promotions"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "schema": {"type": "string", "minLength": 1},
              "required_states": {"type": "array", "minItems": 1, "items": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_IMPLEMENTED", "NOT_EXERCISED", "SKIPPED_BY_POLICY", "HUMAN_ADMIT_REQUIRED"]}, "uniqueItems": true},
              "forbidden_promotions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            }
          },
          "exit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requires_receipt", "required_verdict", "cleanup_required"],
            "properties": {
              "requires_receipt": {"const": true},
              "required_verdict": {"const": "PASS"},
              "cleanup_required": {"type": "boolean"}
            }
          },
          "next": {"type": ["string", "null"]}
        }
      }
    }
  }
}
