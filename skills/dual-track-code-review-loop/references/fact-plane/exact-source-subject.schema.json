{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtcr-exact-source-subject.schema.json",
  "title": "DTCR exact source subject",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "commit", "tree"],
  "properties": {
    "schema": {"const": "dtcr/exact-source-subject/v1"},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "Logical owner/repository identity, never a local checkout path."
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "diff": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_commit", "head_commit", "changed_paths", "diff_sha256"],
          "properties": {
            "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "changed_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/repo_path"}
            },
            "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    }
  },
  "examples": [
    {
      "schema": "dtcr/exact-source-subject/v1",
      "repository": "example/project",
      "commit": "0123456789abcdef0123456789abcdef01234567",
      "tree": "89abcdef0123456789abcdef0123456789abcdef",
      "diff": null
    }
  ],
  "x-refusal-controls": [
    {
      "case_id": "DTCR-D1C-SUBJECT-001",
      "refuses": "Mutable main used as an exact commit.",
      "refused_by": "properties.commit.pattern",
      "instance": {
        "schema": "dtcr/exact-source-subject/v1",
        "repository": "example/project",
        "commit": "main",
        "tree": "89abcdef0123456789abcdef0123456789abcdef"
      }
    },
    {
      "case_id": "DTCR-D1C-SUBJECT-002",
      "refuses": "Machine-local path used as a repository-relative changed path.",
      "refused_by": "$defs.repo_path.pattern",
      "instance": {
        "schema": "dtcr/exact-source-subject/v1",
        "repository": "example/project",
        "commit": "0123456789abcdef0123456789abcdef01234567",
        "tree": "89abcdef0123456789abcdef0123456789abcdef",
        "diff": {
          "base_commit": "fedcba9876543210fedcba9876543210fedcba98",
          "head_commit": "0123456789abcdef0123456789abcdef01234567",
          "changed_paths": ["/tmp/project/domain/order.go"],
          "diff_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      }
    }
  ]
}
