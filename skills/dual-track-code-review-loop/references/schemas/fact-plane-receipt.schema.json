{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtcr-fact-plane-receipt.schema.json",
  "title": "DTCR fact plane receipt",
  "description": "One normalized bundle of provider runs against one exact subject, and the ledger row that records it happened. It is the fact plane's counterpart to the verification receipt and keeps the same laws: one arrival per receipt, an exit code behind every outcome that claims to have run, and a grants block whose constants make overclaiming unrepresentable rather than discouraged. The addition is `task_pass`, because a fact-plane bundle is where provider greenness most wants to become task greenness: four adapters exiting zero is a statement about four processes, and the task they were run for is closed by a closure record that reads this receipt rather than by the receipt itself. The ledger reference is a digest and a monotonic sequence with no room for a mutable label, so a row cannot be re-pointed at a different event while keeping its identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "subject", "arrival", "provider_runs", "ledger_event", "bundle_digest", "coverage_ceiling_ref", "summary", "grants"],
  "properties": {
    "schema": {"const": "dtcr/fact-plane-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^DTCR-FR-[0-9]{3}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_binding_id", "commit", "tree"],
      "properties": {
        "repository_binding_id": {"type": "string", "pattern": "^DTCR-RB-[0-9a-f]{16}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "arrival": {
      "enum": ["STATIC", "SANDBOX"],
      "description": "A parser, an index and a graph query all report that something is the case in the tree; none of them reports that it ran in production. PROD is absent from this enum because no fact-plane provider can produce it."
    },
    "provider_runs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/provider_run"}
    },
    "ledger_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_digest", "sequence", "ledger_schema_digest"],
      "properties": {
        "event_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "SQLITE_EVENT_ID_DRIFT refused here. A monotonic integer beside a content digest; there is no key in this object for a mutable label such as latest or current, and none can be added."
        },
        "ledger_schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "description": "The canonical ledger stores the task and event history. It does not store the truth about the source, the tests or the history of the repository, each of which is read from its own authority."
    },
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage_ceiling_ref": {
      "type": "string",
      "pattern": "^DTCR-CC-[0-9]{3}$",
      "description": "The ceiling that says how much of the subject these runs reached. A bundle with no ceiling reads as a bundle over everything."
    },
    "summary": {
      "type": "string",
      "minLength": 12,
      "maxLength": 800,
      "not": {
        "pattern": "(?i)(100\\s*%|zero false positives|zero errors|fully compliant|no false negatives|guarantee|guaranteed|guarantees|bulletproof|unbreakable)"
      },
      "description": "The same ten literal spellings the verification receipt refuses, refused here for the same reason and with the same limit: it is a word filter over habitual phrasings, not a check on meaning, and a paraphrase that avoids all ten passes and stays a reviewer's problem."
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_pass", "merge", "permission", "secret", "production", "release", "semantic_truth"],
      "properties": {
        "task_pass": {
          "const": false,
          "description": "PROVIDER_PASS_PROMOTED_TO_TASK_PASS refused here. Every adapter exiting zero is a fact about the adapters."
        },
        "merge": {"const": false},
        "permission": {"const": false},
        "secret": {"const": false},
        "production": {"const": false},
        "release": {"const": false},
        "semantic_truth": {"const": false}
      }
    }
  },
  "$defs": {
    "provider_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_binding_id", "executable_name", "version", "executable_sha256", "config_digest", "input_digest", "output_digest", "exit_code", "outcome", "warnings", "omissions"],
      "properties": {
        "provider_binding_id": {"type": "string", "pattern": "^DTCR-PB-[0-9a-f]{16}$"},
        "executable_name": {"type": "string", "minLength": 1, "not": {"pattern": "[/\\\\]|^~"}},
        "version": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The index, grammar or query set this run consumed. Without it a rerun that disagrees cannot be told from a rerun over different inputs."
        },
        "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
        "outcome": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_IMPLEMENTED", "NOT_EXERCISED", "SKIPPED_BY_POLICY", "HUMAN_ADMIT_REQUIRED"]},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "omissions": {"type": "array", "items": {"type": "string", "minLength": 2}}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"enum": ["PASS", "FAIL"]}}, "required": ["outcome"]},
          "then": {
            "properties": {"exit_code": {"type": "integer"}},
            "description": "A provider outcome with no exit code behind it is a claim about a process nobody started."
          }
        }
      ]
    }
  },
