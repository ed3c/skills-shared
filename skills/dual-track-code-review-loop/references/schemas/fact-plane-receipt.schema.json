      "coverage_ceiling_ref": "DTCR-CC-001",
      "summary": "Two adapters ran against this commit; the syntax lane exited zero over the blobs the installed grammars covered and the interface lane was not exercised.",
      "grants": {
        "task_pass": false,
        "merge": false,
        "permission": false,
        "secret": false,
        "production": false,
        "release": false,
        "semantic_truth": false
      }
    }
  ],
