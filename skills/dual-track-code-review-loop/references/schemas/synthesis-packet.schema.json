          "merge": false,
          "paid_demand": false,
          "permission": false,
          "production": false,
          "release": false,
          "secret": false,
          "user_value": false
        },
        "fact_lane": {
          "bundle_digest": "3f786850e387550fdab836ed7e6dc881de23001b3f786850e387550fdab836ed",
          "coverage_ceiling_ref": "DTCR-CC-001",
          "observation_refs": [
            "DTCR-SF-001",
            "DTCR-VC-001",
            "DTCR-VC-002"
          ],
          "receipt_ref": "DTCR-FR-001",
          "state": "NOT_APPLICABLE"
        },
        "invariant_refs": [
          "DTCR-AI-001",
          "DTCR-AI-002"
        ],
        "packet_id": "DTCR-SP-001",
        "schema": "dtcr/synthesis-packet/v1",
        "semantic_lane": {
          "consumed_row_refs": [
            "DTCR-BK-001"
          ],
          "result_ref": "DTCR-RR-001",
          "state": "PRESENT"
        },
        "subject": {
          "repository_binding_id": "DTCR-RB-0f1e2d3c4b5a6978",
          "subject_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
          "subject_tree": "e739d799dd8d44beb5414ed99a943ff3bacccab0"
