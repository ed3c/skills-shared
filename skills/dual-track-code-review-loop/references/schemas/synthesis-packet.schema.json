      "schema": "dtcr/synthesis-packet/v1",
      "semantic_lane": {
        "consumed_row_refs": [],
        "rationale": "the request declared the literal NOT_APPLICABLE for the semantic context lane",
        "state": "NOT_APPLICABLE"
      },
      "subject": {
        "repository_binding_id": "DTCR-RB-0f1e2d3c4b5a6978",
        "subject_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
        "subject_tree": "e739d799dd8d44beb5414ed99a943ff3bacccab0"
      },
      "task_ref": "review the task queue ordering change with no semantic index available"
    }
  ],
  "x-refusal-controls": [
    {
      "case_id": "DTCR-XC-SY-001",
      "refuses": "A synthesis whose deterministic lane is reported as not applicable.",
      "refused_by": "properties.fact_lane.properties.state.const",
      "instance": {
