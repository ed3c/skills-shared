{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtcr-synthesis-packet.schema.json",
  "title": "DTCR synthesis packet",
  "description": "What one exact task, one deterministic fact bundle, one optional semantic context bundle and one admitted invariant set compiled to, before any of it is written up for a reader. The two lanes are deliberately asymmetric: the fact lane's state is pinned PRESENT because a review with no deterministic observation is not a review with a weak one, while the semantic lane may be the literal NOT_APPLICABLE and must then say why and carry no result. That asymmetry is the whole point of the packet -- an absent semantic lane and a quiet one look identical downstream unless the absence is typed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "task_ref",
    "subject",
    "fact_lane",
    "semantic_lane",
    "invariant_refs",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "dtcr/synthesis-packet/v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^DTCR-SP-[0-9]{3}$"
    },
    "task_ref": {
      "type": "string",
      "minLength": 8
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_binding_id",
        "subject_commit",
        "subject_tree"
      ],
      "properties": {
        "repository_binding_id": {
          "type": "string",
          "pattern": "^DTCR-RB-[0-9a-f]{16}$"
        },
        "subject_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Exact commit. A branch, a tag, main or latest names a moving tree and dates the packet to nothing."
        },
        "subject_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "fact_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "receipt_ref",
        "bundle_digest",
        "coverage_ceiling_ref",
        "observation_refs"
      ],
      "properties": {
        "state": {
          "const": "PRESENT",
          "description": "The only value. The deterministic lane has no NOT_APPLICABLE: a synthesis with nothing observed is refused at the compiler, not recorded here as an empty lane."
        },
        "receipt_ref": {
          "type": "string",
          "pattern": "^DTCR-FR-[0-9]{3}$"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage_ceiling_ref": {
          "type": "string",
          "pattern": "^DTCR-CC-[0-9]{3}$",
          "description": "The ceiling the bundle was produced under. A packet with no ceiling reads as a packet over everything."
        },
        "observation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          },
          "description": "Every deterministic observation carried forward. A fact dropped here because retrieved context disagreed with it is the mutation the compiler refuses by name."
        }
      }
    },
    "semantic_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "consumed_row_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "NOT_APPLICABLE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 12
        },
        "result_ref": {
          "type": "string",
          "pattern": "^DTCR-RR-[0-9]{3}$"
        },
        "consumed_row_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DTCR-BK-[0-9]{3}$"
          },
          "description": "Exact back references, not scores. A manifest of ranks tells a reader that context was used and not which context."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "rationale"
            ],
            "not": {
              "required": [
                "result_ref"
              ]
            },
            "description": "A lane declared inapplicable that still points at a retrieval result was applicable and is being reported as absent."
          }
        }
      ]
    },
    "invariant_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DTCR-AI-[0-9]{3}$"
      },
      "description": "Admitted invariants only. An invariant nobody admitted is a preference, and a violation of a preference is an opinion with an identifier."
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge",
        "permission",
        "secret",
        "production",
        "user_value",
        "paid_demand",
        "release"
      ],
      "properties": {
        "merge": {
          "const": false
        },
        "permission": {
          "const": false
        },
        "secret": {
          "const": false
        },
        "production": {
          "const": false
        },
        "user_value": {
          "const": false
        },
        "paid_demand": {
          "const": false
        },
        "release": {
          "const": false
        }
      }
    }
  },
  "examples": [
    {
      "authority": {
        "merge": false,
        "paid_demand": false,
        "permission": false,
        "production": false,
        "release": false,
        "secret": false,
        "user_value": false
      },
