        }
      }
    },
    {
      "case_id": "DTCR-XC-MP-005",
      "refuses": "A proposal that records itself as having preserved behavior, before any frozen test has run.",
      "refused_by": "properties.establishes.properties.behavior_preserved.const",
      "instance": {
        "schema": "dtcr/refactor-minimal-port/v1",
        "port_id": "DTCR-PT-001",
        "signature_ref": "DTCR-US-001",
        "subject": {
          "repository_binding_id": "DTCR-RB-0f1e2d3c4b5a6978",
          "subject_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
          "subject_tree": "e739d799dd8d44beb5414ed99a943ff3bacccab0"
        },
        "owning_layer": "DOMAIN",
        "port_members": [
          {
