{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtcr-exact-source-subject.schema.json",
  "title": "DTCR exact source subject",
  "description": "The one thing every deterministic fact is about: an exact repository, an exact commit, an exact tree, and the exact blobs that were read. Two properties are structural rather than advisory. The repository is an opaque binding identifier, so there is no key here in which a clone URL, a host or a machine path fits, and a provider's own repository name never becomes the universal identity of the subject. The diff carries only its base, because the head of a diff is the subject commit and this object has no second key for it: a diff computed against a head that has since moved cannot be expressed rather than being discouraged. What the schema cannot do is check that the blobs listed are the blobs that commit actually contains; that comparison belongs to whoever resolves the tree.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject_id", "repository_binding_id", "commit", "tree", "blobs", "diff", "authority_ceiling"],
  "properties": {
    "schema": {"const": "dtcr/exact-source-subject/v1"},
    "subject_id": {"type": "string", "pattern": "^DTCR-SS-[0-9]{3}$"},
    "repository_binding_id": {
      "type": "string",
      "pattern": "^DTCR-RB-[0-9a-f]{16}$",
      "description": "Opaque binding identifier resolved by the consumer. A remote URL, an owner/name pair or a working-copy path each describe one account or one machine and read as evidence everywhere else."
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact commit. A branch, tag, HEAD or latest names a moving tree, and a fact dated to a moving tree is dated to nothing."
    },
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "blobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blob_ref"},
      "description": "Every blob the pass actually read. A subject that names a commit but no blobs describes the tree the reader imagines."
    },
    "diff": {
      "oneOf": [
        {"const": "NO_DIFF_SUBJECT"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_commit", "changed_paths", "diff_digest"],
          "properties": {
            "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "changed_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/repo_relative_path"}
            },
            "diff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "description": "Base only. The head of this diff is the subject commit above; there is deliberately no key here to write a different one into, so a diff and the subject it is attached to cannot silently disagree."
        }
      ]
    },
    "authority_ceiling": {"$ref": "#/$defs/fact_ceiling"}
  },
  "$defs": {
    "repo_relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(/|~|[A-Za-z][A-Za-z0-9+.-]*://)|(^|/)\\.\\.(/|$)"},
      "description": "Repository-relative. An absolute path, a home-relative path, a URI scheme or a parent traversal describes a location on one machine rather than a place in this tree."
    },
    "blob_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blob", "byte_count"],
      "properties": {
        "path": {"$ref": "#/$defs/repo_relative_path"},
        "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "byte_count": {"type": "integer", "minimum": 0}
      }
    },
    "fact_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_truth", "complete_account_of_behaviour", "task_pass", "merge"],
      "properties": {
        "semantic_truth": {"const": false},
        "complete_account_of_behaviour": {"const": false},
        "task_pass": {"const": false},
        "merge": {"const": false}
      },
      "description": "Stated as constants so that overclaiming is unrepresentable here rather than discouraged elsewhere. A subject binding is what was read; it is not what the code means and it is not an admission."
    }
  },
  "examples": [
    {
      "schema": "dtcr/exact-source-subject/v1",
      "subject_id": "DTCR-SS-001",
      "repository_binding_id": "DTCR-RB-9f2c41ab8d0e7c65",
      "commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
      "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
      "blobs": [
        {
          "path": "domain/order/pricing.ext",
          "blob": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391",
          "byte_count": 4120
        }
      ],
      "diff": {
        "base_commit": "3f4a1d9b0c7e2a58d61f8b4c3e9a70d215c6b8e4",
        "changed_paths": ["domain/order/pricing.ext"],
        "diff_digest": "d4a3d8e212371f5c8fb5511e2c69b367a8069d9489f3bbf3e276526572f7329f"
      },
      "authority_ceiling": {
        "semantic_truth": false,
        "complete_account_of_behaviour": false,
        "task_pass": false,
        "merge": false
      }
    }
  ],
  "x-refusal-controls": [
    {
      "case_id": "DTCR-XC-SS-001",
      "refuses": "WRONG_REPOSITORY_OR_TREE: a subject dated to a branch name instead of an exact commit.",
      "refused_by": "properties.commit.pattern",
      "instance": {
        "schema": "dtcr/exact-source-subject/v1",
        "subject_id": "DTCR-SS-002",
        "repository_binding_id": "DTCR-RB-9f2c41ab8d0e7c65",
        "commit": "main",
        "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "blobs": [
          {"path": "domain/order/pricing.ext", "blob": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391", "byte_count": 4120}
        ],
        "diff": "NO_DIFF_SUBJECT",
        "authority_ceiling": {
          "semantic_truth": false,
          "complete_account_of_behaviour": false,
          "task_pass": false,
          "merge": false
        }
      }
    },
    {
      "case_id": "DTCR-XC-SS-002",
      "refuses": "A repository identified by a clone locator rather than by an opaque binding identifier.",
      "refused_by": "properties.repository_binding_id.pattern",
      "instance": {
        "schema": "dtcr/exact-source-subject/v1",
        "subject_id": "DTCR-SS-003",
        "repository_binding_id": "https://example.invalid/org/service.git",
        "commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
        "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "blobs": [
          {"path": "domain/order/pricing.ext", "blob": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391", "byte_count": 4120}
        ],
        "diff": "NO_DIFF_SUBJECT",
        "authority_ceiling": {
          "semantic_truth": false,
          "complete_account_of_behaviour": false,
          "task_pass": false,
          "merge": false
        }
      }
    },
    {
      "case_id": "DTCR-XC-SS-003",
      "refuses": "STALE_DIFF: a diff carrying its own head commit, free to drift from the subject it is attached to.",
      "refused_by": "properties.diff.oneOf[1].additionalProperties",
      "instance": {
        "schema": "dtcr/exact-source-subject/v1",
        "subject_id": "DTCR-SS-004",
        "repository_binding_id": "DTCR-RB-9f2c41ab8d0e7c65",
        "commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
        "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "blobs": [
          {"path": "domain/order/pricing.ext", "blob": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391", "byte_count": 4120}
        ],
        "diff": {
          "base_commit": "3f4a1d9b0c7e2a58d61f8b4c3e9a70d215c6b8e4",
          "head_commit": "7c1e5b0a94d2f36e8b0517ac4d9f2e6b3a08c15d",
          "changed_paths": ["domain/order/pricing.ext"],
          "diff_digest": "d4a3d8e212371f5c8fb5511e2c69b367a8069d9489f3bbf3e276526572f7329f"
        },
        "authority_ceiling": {
          "semantic_truth": false,
          "complete_account_of_behaviour": false,
          "task_pass": false,
          "merge": false
        }
      }
    },
    {
      "case_id": "DTCR-XC-SS-004",
      "refuses": "A blob identified by a machine-local path instead of a repository-relative one.",
      "refused_by": "$defs.repo_relative_path.not",
      "instance": {
        "schema": "dtcr/exact-source-subject/v1",
        "subject_id": "DTCR-SS-005",
        "repository_binding_id": "DTCR-RB-9f2c41ab8d0e7c65",
        "commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
        "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "blobs": [
          {"path": "~/example-checkout/domain/order/pricing.ext", "blob": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391", "byte_count": 4120}
        ],
        "diff": "NO_DIFF_SUBJECT",
        "authority_ceiling": {
          "semantic_truth": false,
          "complete_account_of_behaviour": false,
          "task_pass": false,
          "merge": false
        }
      }
    },
    {
      "case_id": "DTCR-XC-SS-005",
      "refuses": "A subject that grants itself authority over the task it was read for.",
      "refused_by": "$defs.fact_ceiling.properties.task_pass.const",
      "instance": {
        "schema": "dtcr/exact-source-subject/v1",
        "subject_id": "DTCR-SS-006",
        "repository_binding_id": "DTCR-RB-9f2c41ab8d0e7c65",
        "commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
        "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "blobs": [
          {"path": "domain/order/pricing.ext", "blob": "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391", "byte_count": 4120}
        ],
        "diff": "NO_DIFF_SUBJECT",
        "authority_ceiling": {
          "semantic_truth": false,
          "complete_account_of_behaviour": false,
          "task_pass": true,
          "merge": false
        }
      }
    }
  ]
}
