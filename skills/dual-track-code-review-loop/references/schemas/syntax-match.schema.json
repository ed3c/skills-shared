      "match_class": "SYNTACTIC_CANDIDATE",
      "grade": "DETERMINISTIC_FACT",
      "provider": {
        "provider_binding_id": "DTCR-PB-1a4c77d0be93f218",
        "executable_name": "syntax-query-runner",
        "version": "0.25.1",
        "executable_sha256": "2819f62833d1867b24fdca003615107418018c5a9dc1864073940c4602c5d105",
        "config_digest": "45dfa450d7e40c0cb9b5c6d3674a3d56e495152216517bcc1f7d8b6db1e5423a",
        "grammar": {
          "language": "example-language",
          "grammar_digest": "802b1a8202117263eed6bc5f3f71c0067e003187fe9f4850b1c8f715f6824de8",
          "abi_version": 14
        },
        "query_digest": "5403ee3a36ad14a5f73443a5780ea48acf61e489fef3f9ee319809c50433862f"
      },
      "parse_status": "CLEAN",
      "error_node_count": 0,
      "completeness": "COMPLETE_FOR_ANALYSED_INPUTS",
      "output_digest": "6615c410e153c94d565173b3494fa40c6aedade2c8a5191e2276e1f38c9b04cd",
      "warnings": [],
      "omissions": ["generated sources under the build output directory were not parsed"],
      "establishes": {"semantic_binding": false, "call_edge": false, "task_pass": false}
    }
  ],
  "x-refusal-controls": [
    {
      "case_id": "DTCR-XC-SM-001",
      "refuses": "TREE_SITTER_QUERY_DIGEST_ABSENT: a match whose query text was never recorded, leaving it exact-looking and unreplayable.",
      "refused_by": "properties.provider.required",
