        "input_document_digest": "45dfa450d7e40c0cb9b5c6d3674a3d56e495152216517bcc1f7d8b6db1e5423a",
        "chunk": {"chunk_index": 2, "chunk_digest": "5403ee3a36ad14a5f73443a5780ea48acf61e489fef3f9ee319809c50433862f", "chunk_byte_count": 940},
        "embedding_provider": {
