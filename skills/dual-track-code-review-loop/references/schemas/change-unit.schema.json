{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtcr-change-unit.schema.json",
  "title": "DTCR change unit",
  "description": "One applied bounded change, bound to the exact base and head it moved between and to the complete list of paths it touched. Merge admission is a single-valued enum, so there is no expressible change unit whose merge follows from its own evidence: a graph query returning zero and a test suite returning green are two arrivals of the same static and sandbox kind, and the source that proposed treating that pair as a merge trigger was proposing to let the thing being checked decide that checking was finished. The authority object states in constants what the record grants, which is nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change_unit_id", "proposal_ref", "base_commit", "head_commit", "changed_paths", "verification_refs", "merge_admission", "authority", "rollback"],
  "properties": {
    "schema": {"const": "dtcr/change-unit/v1"},
    "change_unit_id": {"type": "string", "pattern": "^DTCR-CU-[0-9]{3}$"},
    "proposal_ref": {"type": "string", "pattern": "^DTCR-RP-[0-9]{3}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repo_path"},
      "description": "The complete denominator, not the interesting subset. A review of the paths someone chose to list is a review of the summary."
    },
    "verification_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DTCR-VR-[0-9]{3}$"}
    },
    "merge_admission": {
      "enum": ["HUMAN_ADMIT_REQUIRED"],
      "description": "One value. Green checks make a change eligible for a human to look at and never make it merged."
    },
    "authority": {"$ref": "#/$defs/authority"},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit"],
      "properties": {
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "description": "The exact commit this change unit returns to. A rollback plan that names a branch returns to whatever that branch has since become."
    }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge", "permission", "secret", "production", "user_value", "paid_demand", "release"],
      "properties": {
        "merge": {"const": false},
        "permission": {"const": false},
        "secret": {"const": false},
        "production": {"const": false},
        "user_value": {"const": false},
        "paid_demand": {"const": false},
        "release": {"const": false}
      },
      "description": "Constants rather than defaults. Overclaiming is not discouraged here, it is unrepresentable."
    }
  },
  "examples": [
    {
      "schema": "dtcr/change-unit/v1",
      "change_unit_id": "DTCR-CU-001",
      "proposal_ref": "DTCR-RP-001",
      "base_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
      "head_commit": "0123456789abcdef0123456789abcdef01234567",
      "changed_paths": ["domain/order.go", "cmd/server/main.go"],
      "verification_refs": ["DTCR-VR-001"],
      "merge_admission": "HUMAN_ADMIT_REQUIRED",
      "authority": {
        "merge": false,
        "permission": false,
        "secret": false,
        "production": false,
        "user_value": false,
        "paid_demand": false,
        "release": false
      },
      "rollback": {"base_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f"}
    }
  ],
  "x-refusal-controls": [
    {
      "case_id": "DTCR-XC-CU-001",
      "refuses": "Automatic merge triggered by one graph count plus a passing test run.",
      "refused_by": "properties.merge_admission.enum",
      "instance": {
        "schema": "dtcr/change-unit/v1",
        "change_unit_id": "DTCR-CU-002",
        "proposal_ref": "DTCR-RP-001",
        "base_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
        "head_commit": "0123456789abcdef0123456789abcdef01234567",
        "changed_paths": ["domain/order.go"],
        "verification_refs": ["DTCR-VR-001"],
        "merge_admission": "AUTOMATIC_ON_ZERO_ILLEGAL_EDGES_AND_GREEN_TESTS",
        "authority": {
          "merge": false,
          "permission": false,
          "secret": false,
          "production": false,
          "user_value": false,
          "paid_demand": false,
          "release": false
        },
        "rollback": {"base_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f"}
      }
    },
    {
      "case_id": "DTCR-XC-CU-002",
      "refuses": "A change unit that grants itself merge authority.",
      "refused_by": "$defs.authority.properties.merge.const",
      "instance": {
        "schema": "dtcr/change-unit/v1",
        "change_unit_id": "DTCR-CU-003",
        "proposal_ref": "DTCR-RP-001",
        "base_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
        "head_commit": "0123456789abcdef0123456789abcdef01234567",
        "changed_paths": ["domain/order.go"],
        "verification_refs": ["DTCR-VR-001"],
        "merge_admission": "HUMAN_ADMIT_REQUIRED",
        "authority": {
          "merge": true,
          "permission": false,
          "secret": false,
          "production": false,
          "user_value": false,
          "paid_demand": false,
          "release": false
        },
        "rollback": {"base_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f"}
      }
    },
    {
      "case_id": "DTCR-XC-CU-003",
      "refuses": "A changed-path denominator carrying a machine-local path.",
      "refused_by": "$defs.repo_path.pattern",
      "instance": {
        "schema": "dtcr/change-unit/v1",
        "change_unit_id": "DTCR-CU-004",
        "proposal_ref": "DTCR-RP-001",
        "base_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f",
        "head_commit": "0123456789abcdef0123456789abcdef01234567",
        "changed_paths": ["/Users/example/checkout/domain/order.go"],
        "verification_refs": ["DTCR-VR-001"],
        "merge_admission": "HUMAN_ADMIT_REQUIRED",
        "authority": {
          "merge": false,
          "permission": false,
          "secret": false,
          "production": false,
          "user_value": false,
          "paid_demand": false,
          "release": false
        },
        "rollback": {"base_commit": "cb48fdc7e8c6bd6db2ff32188047eab9a5340c9f"}
      }
    }
  ]
}
