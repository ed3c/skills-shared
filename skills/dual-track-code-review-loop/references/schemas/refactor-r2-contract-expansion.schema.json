{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtcr-refactor-r2-contract-expansion.schema.json",
  "title": "DTCR cross-repository Expand & Contract (R2) contract expansion",
  "description": "The C1 phase of one cross-repository Expand & Contract run: the central contract repository at an exact commit, the old version the new one was added beside, the compatibility result and the rule category it was computed under, the digest of every generated artifact and where it was generated from, and whether anything was published. Expansion is the phase whose failures are invisible later: a compatibility PASS computed under a looser category than the baseline, or with the changed paths excluded, is a green that was never earned, and the consumers that migrate against it find out at their next deploy. Nothing here establishes that a contract was published or that the old surface was removed; both are pinned false, and both are separately authorized operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "expansion_id",
    "subject",
    "contract_version_old",
    "contract_version_new",
    "adapter",
    "compatibility",
    "generated_artifacts",
    "publication",
    "establishes"
  ],
  "properties": {
    "schema": {
      "const": "dtcr/refactor-r2-contract-expansion/v1"
    },
    "expansion_id": {
      "type": "string",
      "pattern": "^DTCR-R2X-[0-9]{3}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_binding_id",
        "subject_commit",
        "subject_tree"
      ],
      "properties": {
        "repository_binding_id": {
          "type": "string",
          "pattern": "^DTCR-RB-[0-9a-f]{16}$"
        },
        "subject_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "subject_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "contract_version_old": {
      "type": "string",
      "minLength": 1
    },
    "contract_version_new": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_binding_id",
        "capability_class",
        "contract_format",
        "format_support",
        "provider_state",
        "vendored",
        "pins"
      ],
      "description": "A declared capability class for one contract format, never a vendored implementation. Protobuf is the format the source flow uses and is deliberately not the only one declared: a protocol that works only when the contract happens to be Protobuf is a registry procedure with a general name. `provider_state` has two values and no EXERCISED, because no adapter implementation ships behind this protocol.",
      "properties": {
        "adapter_binding_id": {
          "type": "string",
          "pattern": "^DTCR-AD-[0-9a-f]{16}$"
        },
        "capability_class": {
          "enum": [
            "WIRE_COMPATIBILITY_CHECK",
            "SCHEMA_COMPATIBILITY_CHECK",
            "CODE_GENERATION",
            "REGISTRY_PUBLICATION"
          ]
        },
        "contract_format": {
          "enum": [
            "protobuf",
            "openapi",
            "json-schema",
            "asyncapi",
            "graphql",
            "avro"
          ]
        },
        "format_support": {
          "const": "SUPPORTED_BY_DECLARED_ADAPTER"
        },
        "provider_state": {
          "enum": [
            "DECLARED_NOT_VENDORED",
            "BLOCKED_ON_PROVIDER"
          ]
        },
        "vendored": {
          "const": false
        },
        "pins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_version",
            "license_id",
            "rule_set_or_dialect",
            "codegen_determinism"
          ],
          "description": "An unpinned tool version, rule set or codegen determinism makes the same contract generate different stubs on a different host, and the drift lands in a consumer repository nobody was watching.",
          "properties": {
            "tool_version": {
              "type": "string",
              "minLength": 1
            },
            "license_id": {
              "type": "string",
              "minLength": 1
            },
            "rule_set_or_dialect": {
              "type": "string",
              "minLength": 1
            },
            "codegen_determinism": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_commit",
        "baseline_rule_category",
        "run_rule_category",
        "excluded_paths",
        "result",
        "rule_category_weakened"
      ],
      "description": "Two rule categories, not one. The baseline records what the contract was checked under before this run; the run records what it was checked under now. Keeping both is the whole of the config-weakening guard: one category alone cannot say whether the check got easier.",
      "properties": {
        "baseline_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseline_rule_category": {
          "enum": [
            "WIRE",
            "WIRE_JSON",
            "PACKAGE",
            "FILE"
          ]
        },
        "run_rule_category": {
          "enum": [
            "WIRE",
            "WIRE_JSON",
            "PACKAGE",
            "FILE"
          ]
        },
        "excluded_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "description": "Always present, empty when nothing was excluded. An absent key would turn the narrowing guard off without saying so."
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "rule_category_weakened": {
          "const": false
        }
      }
    },
    "generated_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "An expansion nobody generated stubs from is a schema edit; consumers migrate against stubs, and the digest is what binds the two.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_path",
          "digest",
          "generated_from_commit"
        ],
        "properties": {
          "artifact_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "generated_from_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "account_access",
        "content_rights",
        "performed"
      ],
      "description": "`account_access` is a capability and `content_rights` is a permission, and they are separate fields because the first is routinely read as the second. `content_rights` is single-valued: no state of this protocol clears the right to publish somebody's schema under a registry's terms, so the only value a receipt may carry is the one that says a person still has to. `performed` is pinned false; this protocol opens no socket.",
      "properties": {
        "intent": {
          "enum": [
            "NONE",
            "REGISTRY_PUBLISH"
          ]
        },
        "account_access": {
          "enum": [
            "ABSENT",
            "AVAILABLE"
          ]
        },
        "content_rights": {
          "const": "HUMAN_ADMIT_REQUIRED"
        },
        "performed": {
          "const": false
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "registry_binding": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "establishes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_surface_removed",
        "published"
      ],
      "description": "Both pinned false. Expanding a contract adds a version beside the old one; removing the old one is the C2 phase and is Human authority, and publishing is an external registry operation this compiler never performs.",
      "properties": {
        "old_surface_removed": {
          "const": false
        },
        "published": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "publication"
        ],
        "properties": {
          "publication": {
            "required": [
              "intent"
            ],
            "properties": {
              "intent": {
                "const": "REGISTRY_PUBLISH"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "required": [
              "source_commit",
              "source_tree",
              "registry_binding"
            ]
          }
        }
      },
      "description": "SCHEMA_PUBLISHED_WITHOUT_EXACT_SOURCE. A publication intent with no exact source commit and tree describes an artifact nobody can trace back to the bytes that produced it."
    }
  ],
