          "tree": "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
        },
        "baseline": {
          "commit": "main",
          "artifact_name": "order-service.interface",
          "artifact_digest": "7e9020312b61a4ef5f69f9ab2305747eb8d0225927a79aa15001dc4a5430eaf0"
        },
        "candidate": {
          "artifact_name": "order-service.interface",
          "artifact_digest": "69371c73bcd19ac4abbe6b7dcba053fb54a913499d8f68817e300d4c15866bca"
        },
        "provider": {
          "provider_binding_id": "DTCR-PB-6b0e93d2a7c14f58",
          "executable_name": "interface-compatibility-checker",
          "version": "1.47.2",
          "executable_sha256": "d4a3d8e212371f5c8fb5511e2c69b367a8069d9489f3bbf3e276526572f7329f",
          "config_digest": "2819f62833d1867b24fdca003615107418018c5a9dc1864073940c4602c5d105",
          "ruleset_digest": "45dfa450d7e40c0cb9b5c6d3674a3d56e495152216517bcc1f7d8b6db1e5423a"
        },
        "outcome": "NO_BREAKING_CHANGE_DETECTED",
        "findings": [],
        "grants": {"deployment": false, "merge": false, "release": false, "task_pass": false}
      }
    },
    {
      "case_id": "DTCR-XC-CK-002",
      "refuses": "A clean headline verdict carrying a breaking finding underneath it.",
      "refused_by": "allOf[0].then",
      "instance": {
        "schema": "dtcr/contract-compatibility-result/v1",
        "result_id": "DTCR-CK-003",
        "subject": {
          "repository_binding_id": "DTCR-RB-9f2c41ab8d0e7c65",
