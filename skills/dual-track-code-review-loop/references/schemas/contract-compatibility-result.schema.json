          "config_digest": "2819f62833d1867b24fdca003615107418018c5a9dc1864073940c4602c5d105",
          "ruleset_digest": "45dfa450d7e40c0cb9b5c6d3674a3d56e495152216517bcc1f7d8b6db1e5423a"
        },
        "outcome": "NO_BREAKING_CHANGE_DETECTED",
        "findings": [],
        "grants": {"deployment": true, "merge": false, "release": false, "task_pass": false}
      }
    },
    {
      "case_id": "DTCR-XC-CK-004",
      "refuses": "A lane recorded as not applicable while carrying findings and no reason it was skipped.",
      "refused_by": "allOf[1].then",
