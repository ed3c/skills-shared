        },
        "consumed_members": [
          {
            "member": "load",
            "member_kind": "METHOD",
            "call_site_refs": [
              "CS-001"
            ]
          }
        ],
        "extraction": {
          "call_sites_declared": 3,
          "call_sites_resolved": 1,
          "unresolved_call_site_refs": [
            "CS-002",
            "CS-003"
          ],
          "completeness": "COMPLETE_FOR_RESOLVED_CALL_SITES"
        },
        "establishes": {
          "provider_surface_complete": false,
          "rewrite_applied": false
        }
      }
    },
    {
      "case_id": "DTCR-XC-RU-002",
      "refuses": "A usage signature dated to a branch name instead of an exact commit.",
