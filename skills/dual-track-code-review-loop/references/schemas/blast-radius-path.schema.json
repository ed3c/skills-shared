{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtcr-blast-radius-path.schema.json",
  "title": "DTCR blast radius path",
  "description": "One traversal from a changed seed through an admitted edge set, and the bounds that stopped it. A recursive traversal over a graph with cycles either carries its bounds or runs until something else stops it, so depth limit, row limit and the reason termination happened are required integers and a closed enum rather than notes: an unbounded traversal cannot be written down here. Visited nodes are unique, which is where a cycle stops being a path that revisits a node and becomes a refusal. The reachable set this path belongs to is bounded by the admitted edge set named in `edge_set`, and every hop declares which admitted kind it used; the schema cannot verify that the digest covers the kinds, so a consumer that trusts the reach without checking the edge set is trusting a number whose denominator it never read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "path_id", "subject", "seed", "edge_set", "hops", "nodes_visited", "traversal_bounds", "authority_ceiling"],
  "properties": {
    "schema": {"const": "dtcr/blast-radius-path/v1"},
    "path_id": {"type": "string", "pattern": "^DTCR-BR-[0-9]{3}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_binding_id", "commit", "tree"],
      "properties": {
        "repository_binding_id": {"type": "string", "pattern": "^DTCR-RB-[0-9a-f]{16}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "seed": {"$ref": "#/$defs/node"},
    "edge_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_set_digest", "admitted_edge_kinds", "edge_provenance", "edge_completeness"],
      "properties": {
        "edge_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "admitted_edge_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["CALLS", "REFERENCES", "IMPLEMENTS", "INHERITS", "IMPORTS", "DEFINES"]},
          "description": "The closed set this traversal was allowed to walk. Reach computed over one edge kind is not reach over another, and a reader who is not told which kinds were walked assumes all of them."
        },
        "edge_provenance": {"enum": ["COMPILER_RESOLVED_CALL", "OCCURRENCE_ENCLOSING_RANGE_HEURISTIC", "TEXTUAL_MATCH", "MIXED"]},
        "edge_completeness": {"enum": ["COMPLETE_FOR_RESOLVED_EDGES", "PARTIAL_LOWER_BOUND", "UNKNOWN"]}
      }
    },
    "hops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "edge_kind"],
        "properties": {
          "from": {"$ref": "#/$defs/node"},
          "to": {"$ref": "#/$defs/node"},
          "edge_kind": {
            "enum": ["CALLS", "REFERENCES", "IMPLEMENTS", "INHERITS", "IMPORTS", "DEFINES"],
            "description": "Drawn from the same closed vocabulary as the admitted set. A hop over an edge kind outside the vocabulary is a traversal of a graph nobody admitted."
          }
        }
      }
    },
    "nodes_visited": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/node"},
      "description": "Unique by construction. A cycle walked twice inflates every count computed from this path, and the inflation is invisible once the rows are aggregated."
    },
    "traversal_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "depth_limit", "row_limit", "terminated_by"],
      "properties": {
        "depth": {"type": "integer", "minimum": 0},
        "depth_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "An integer, always. There is no value here spelling unbounded, which is the structural form of UNBOUNDED_RECURSIVE_CTE."
        },
        "row_limit": {"type": "integer", "minimum": 1},
        "terminated_by": {"enum": ["EDGE_SET_EXHAUSTED", "DEPTH_LIMIT_REACHED", "ROW_LIMIT_REACHED", "CYCLE_GUARD"]}
      }
    },
    "authority_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete_reachable_set", "semantic_truth", "task_pass"],
      "properties": {
        "complete_reachable_set": {
          "const": false,
          "description": "Reach over an admitted edge set is a lower bound on impact. Dynamic dispatch, configuration, generated code and runtime wiring all move impact along edges no static set contains."
        },
        "semantic_truth": {"const": false},
        "task_pass": {"const": false}
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_scoped_id", "normalization"],
      "properties": {
        "provider_scoped_id": {"type": "string", "minLength": 1},
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "scheme_digest"],
          "properties": {
            "scheme": {"type": "string", "minLength": 2},
            "scheme_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  },
