        "owning_decision": "service objective for the checkout path",
        "back_reference_ref": "DTCR-BK-005",
        "authority_ceiling": {
          "current_policy": false,
          "deterministic_fact": false,
          "task_pass": false
        }
      },
      "content": {
        "plane": "PUBLIC_TREE",
        "text": "Checkout path service objective. The gateway serves the checkout read path within the stated latency budget over a rolling window, measured at the gateway edge.\n\nScope. The objective covers the gateway edge only and says nothing about the persistence layer behind it."
      }
