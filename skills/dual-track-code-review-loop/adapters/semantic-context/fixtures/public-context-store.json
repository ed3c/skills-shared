        "observed_revision": "1",
        "observed_at": "2026-08-20",
        "subsystem_tags": [
          "scheduler"
        ],
        "owning_decision": "incident review for the scheduler stall",
        "back_reference_ref": "DTCR-BK-004",
        "authority_ceiling": {
          "current_policy": false,
          "deterministic_fact": false,
          "task_pass": false
        }
      },
      "content": {
        "plane": "PUBLIC_TREE",
        "text": "Scheduler stall incident review. The scheduler queue stopped draining after a worker lease expired without being renewed, and the stall was cleared by restarting the worker pool.\n\nFollow up. The lease renewal path has no timeout and no observation of its own; this review records the stall, it does not reproduce it."
      }
    },
    {
