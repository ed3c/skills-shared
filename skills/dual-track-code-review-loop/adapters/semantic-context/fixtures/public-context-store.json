        "document_digest": "adb18e1f1a62a5cd1a0253d304ad6ef929c1443351c9cb60e86e9f38de0d99fd",
        "authority": "NON_AUTHORITATIVE_CANDIDATE",
        "visibility_class": "PUBLIC_TREE",
        "storage_plane": "PUBLIC_TREE",
        "observed_revision": "4",
        "observed_at": "2026-08-21",
        "subsystem_tags": [
          "domain",
          "persistence"
        ],
        "owning_decision": "decision record on domain isolation",
        "back_reference_ref": "DTCR-BK-001",
        "authority_ceiling": {
          "current_policy": false,
          "deterministic_fact": false,
          "task_pass": false
        }
      },
      "content": {
        "plane": "PUBLIC_TREE",
        "text": "Domain isolation decision. The domain layer holds no persistence types and no transport types. Adapters translate at the boundary and the domain never imports them.\n\nConsequence. A domain module that imports a persistence client is a boundary violation and is reviewed as one."
      }
    },
    {
      "document": {
        "schema": "dtcr/semantic-document/v1",
        "document_id": "DTCR-DOC-002",
        "document_kind": "DECISION_RECORD",
        "document_digest": "c7b0b2f209510999cf71ee5c1b5c61b1800b12ce1f159bb800a2204dfbe1329f",
        "authority": "NON_AUTHORITATIVE_CANDIDATE",
        "visibility_class": "PUBLIC_TREE",
        "storage_plane": "PUBLIC_TREE",
        "observed_revision": "1",
        "observed_at": "2024-02-11",
        "subsystem_tags": [
          "checkout",
          "persistence"
        ],
        "owning_decision": "legacy persistence rule for the checkout ledger",
        "back_reference_ref": "DTCR-BK-002",
        "authority_ceiling": {
          "current_policy": false,
          "deterministic_fact": false,
          "task_pass": false
        }
      },
      "content": {
        "plane": "PUBLIC_TREE",
        "text": "Legacy persistence rule for the checkout ledger. Every checkout ledger write goes through the shared checkout ledger client directly, because the checkout ledger path needs the lowest write latency and the checkout ledger client is already loaded.\n\nConsequence. Checkout ledger modules import the checkout ledger client and call the checkout ledger client inline. Persistence review of the checkout ledger write path stops at the checkout ledger client call."
      }
    },
    {
      "document": {
        "schema": "dtcr/semantic-document/v1",
        "document_id": "DTCR-DOC-003",
        "document_kind": "DECISION_RECORD",
        "document_digest": "1c2a9b739026c8183ec9aa51af8e4971942584abba3a32668cbe116507912718",
        "authority": "NON_AUTHORITATIVE_CANDIDATE",
        "visibility_class": "PUBLIC_TREE",
        "storage_plane": "PUBLIC_TREE",
        "observed_revision": "2",
        "observed_at": "2025-11-03",
        "subsystem_tags": [
          "checkout",
          "persistence"
        ],
        "owning_decision": "replacement persistence rule for the checkout ledger",
        "back_reference_ref": "DTCR-BK-003",
        "authority_ceiling": {
          "current_policy": false,
          "deterministic_fact": false,
          "task_pass": false
        }
      },
      "content": {
        "plane": "PUBLIC_TREE",
        "text": "Replacement persistence rule for the checkout ledger. Checkout ledger writes go through the persistence port. The direct client call is removed from the checkout write path.\n\nConsequence. The legacy persistence rule no longer holds and checkout persistence review reads the port contract."
      }
    },
    {
      "document": {
        "schema": "dtcr/semantic-document/v1",
        "document_id": "DTCR-DOC-004",
        "document_kind": "INCIDENT_REVIEW",
        "document_digest": "f439b1927f99d581d374e633fe73de1415086f695571666ef1de54b5730ef786",
        "authority": "NON_AUTHORITATIVE_CANDIDATE",
        "visibility_class": "PUBLIC_TREE",
