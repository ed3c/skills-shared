__pycache__/
*.pyc
sites.local.json

# Session worktrees. Git already hides a *registered* worktree from the parent's
# status, but a removal that fails partway leaves a full checkout behind, and
# `git add -A` in this tree would stage all of it.
.claude/worktrees/
.grepai/
.serena/

# The adapter evidence ledger is rebuilt from the receipts beside it on every
# capture, so committing it would version a derived file that changes whenever
# anything is captured. It sits inside the receipt directory that capture writes
# to, which means `git add` on that directory stages it unless it is ignored --
# it was removed by hand before each of the first commits, and remembering that
# every time is the wrong mechanism.
skills/repo-agent-native/evals/receipts/*.sqlite3
skills/repo-agent-native/evals/receipts/*.scip
skills/repo-agent-native/evals/receipts/lancedb/

# Working directories the procedural-shadow-runtime adapters write to when a
# caller points --output at the repository root. Everything a committed receipt
# references by digest has been copied into evals/receipts/ and is verified
# against that digest by tests/verify_arm_trials.py and verify_multimodal.py.
# What stays here is the rest: per-cell handoff files the Codex adapter writes
# then reads back, the generated Playwright driver, a retrieval cache, and
# duplicate outputs from re-runs. None of it is referenced by anything, and
# committing a cache would version a file whose whole purpose is to be stale.
.arm-runs/
.multimodal/
.retrieval/
.feedback/
