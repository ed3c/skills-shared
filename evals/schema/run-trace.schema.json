{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/run-trace.schema.json",
  "title": "skill-eval-run-trace/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "condition", "skill_sha", "model", "harness", "environment", "seed", "outcome", "metrics"],
  "properties": {
    "schema_version": {"const": "skill-eval-run/v1"},
    "run_id": {"type": "string", "minLength": 8},
    "case_id": {"type": "string", "minLength": 3},
    "condition": {"enum": ["no_skill", "current_skill", "candidate_skill", "wrong_skill", "composed_skills"]},
    "skill_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "fresh_workspace", "network_policy"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "fresh_workspace": {"type": "boolean"},
        "network_policy": {"type": "string", "minLength": 1}
      }
    },
    "seed": {"type": "integer", "minimum": 0},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "verifier", "failure_class"],
      "properties": {
        "passed": {"type": "boolean"},
        "verifier": {"type": "string", "minLength": 1},
        "failure_class": {
          "type": ["string", "null"],
          "enum": [null, "wrong-trigger", "missed-trigger", "wrong-skill-selection", "missing-domain-knowledge", "ambiguous-contract", "incorrect-tool-use", "environment-assumption", "context-loss", "bad-recovery", "weak-verification", "reward-hacking", "unsafe-side-effect", "executor-error"]
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "should_invoke": {"type": "boolean"},
        "did_invoke": {"type": "boolean"},
        "selected_skill": {"type": ["string", "null"]}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "tool_calls", "input_tokens", "output_tokens", "retries"],
      "properties": {
        "wall_seconds": {"type": "number", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
