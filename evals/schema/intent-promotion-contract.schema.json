{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/intent-promotion-contract.schema.json",
  "title": "Intent Promotion Contract",
  "description": "Controls lifecycle promotion and durable writeback without treating PR, CI, flags, or semantic similarity as authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "subject_identity",
    "intent_bound_contract",
    "lifecycle",
    "evaluator_registry",
    "writeback_policy",
    "approval_policy",
    "supersession_policy",
    "completion_policy",
    "private_reasoning_persistence"
  ],
  "properties": {
    "schema_version": {
      "const": "intent-promotion-contract/v1"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "tree_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "intent_bound_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "contract_id",
        "contract_version",
        "git_blob_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "transitions",
        "non_durable_states",
        "terminal_states"
      ],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "HYPOTHESIS",
              "CANDIDATE",
              "PROPOSED",
              "VERIFIED",
              "ADMITTED",
              "CANONICAL",
              "SUPERSEDED",
              "REVOKED"
            ]
          }
        },
        "non_durable_states": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "HYPOTHESIS",
              "CANDIDATE",
              "PROPOSED",
              "VERIFIED"
            ]
          }
        },
        "terminal_states": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SUPERSEDED",
              "REVOKED"
            ]
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "requires"
            ],
            "properties": {
              "from": {
                "enum": [
                  "HYPOTHESIS",
                  "CANDIDATE",
                  "PROPOSED",
                  "VERIFIED",
                  "ADMITTED",
                  "CANONICAL"
                ]
              },
              "to": {
                "enum": [
                  "CANDIDATE",
                  "PROPOSED",
                  "VERIFIED",
                  "ADMITTED",
                  "CANONICAL",
                  "SUPERSEDED",
                  "REVOKED"
                ]
              },
              "requires": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "LOCAL_EVALUATOR_RECEIPT",
                    "EXACT_PR_SUBJECT",
                    "OWNING_EXACT_HEAD_RECEIPT",
                    "ADMITTED_SUBJECT",
                    "HUMAN_APPROVAL",
                    "SUPERSESSION_TARGET",
                    "REVOCATION_REASON"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "evaluator_registry": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evaluator_id",
          "version",
          "implementation_digest",
          "implementation_path",
          "authority",
          "owning",
          "required_for_states"
        ],
        "properties": {
          "evaluator_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "implementation_digest": {
            "type": "string",
            "pattern": "^(sha256:[0-9a-f]{64}|git-sha1:[0-9a-f]{40})$"
          },
          "authority": {
            "enum": [
              "LOCAL",
              "OWNING_CI",
              "EXTERNAL"
            ]
          },
          "owning": {
            "type": "boolean"
          },
          "required_for_states": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "CANDIDATE",
                "PROPOSED",
                "VERIFIED",
                "ADMITTED",
                "CANONICAL",
                "SUPERSEDED",
                "REVOKED"
              ]
            }
          },
          "implementation_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "writeback_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only",
        "similarity_overwrite_allowed",
        "durable_writeback_min_state",
        "declared_destinations"
      ],
      "properties": {
        "append_only": {
          "const": true
        },
        "similarity_overwrite_allowed": {
          "const": false
        },
        "durable_writeback_min_state": {
          "const": "ADMITTED"
        },
        "declared_destinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destination_id",
              "scope",
              "durability",
              "allowed_states",
              "locator_prefix",
              "human_owned"
            ],
            "properties": {
              "destination_id": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "SESSION",
                  "SCRATCHPAD",
                  "PR_METADATA",
                  "EVIDENCE",
                  "MODULE",
                  "PROJECT",
                  "ROOT_GLOBAL",
                  "HISTORY"
                ]
              },
              "durability": {
                "enum": [
                  "TRANSIENT",
                  "DURABLE"
                ]
              },
              "allowed_states": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "HYPOTHESIS",
                    "CANDIDATE",
                    "PROPOSED",
                    "VERIFIED",
                    "ADMITTED",
                    "CANONICAL",
                    "SUPERSEDED",
                    "REVOKED"
                  ]
                }
              },
              "locator_prefix": {
                "type": "string",
                "minLength": 1
              },
              "human_owned": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "approval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_may_create_approval",
        "automation_may_create_approval",
        "caller_flag_may_request",
        "caller_flag_may_grant",
        "root_global_requires_human"
      ],
      "properties": {
        "agent_may_create_approval": {
          "const": false
        },
        "automation_may_create_approval": {
          "const": false
        },
        "caller_flag_may_request": {
          "const": true
        },
        "caller_flag_may_grant": {
          "const": false
        },
        "root_global_requires_human": {
          "const": true
        }
      }
    },
    "supersession_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only_history",
        "replacement_requires_supersedes",
        "similarity_match_is_authority",
        "terminal_projection_must_be_false"
      ],
      "properties": {
        "append_only_history": {
          "const": true
        },
        "replacement_requires_supersedes": {
          "const": true
        },
        "similarity_match_is_authority": {
          "const": false
        },
        "terminal_projection_must_be_false": {
          "const": true
        }
      }
    },
    "completion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stale_evidence_blocks",
        "evaluator_change_invalidates",
        "pr_open_is_non_authoritative",
        "ci_green_without_owning_receipt_is_non_authoritative",
        "deterministic_failure_vetoes_advisory",
        "private_chain_of_thought"
      ],
      "properties": {
        "stale_evidence_blocks": {
          "const": true
        },
        "evaluator_change_invalidates": {
          "const": true
        },
        "pr_open_is_non_authoritative": {
          "const": true
        },
        "ci_green_without_owning_receipt_is_non_authoritative": {
          "const": true
        },
        "deterministic_failure_vetoes_advisory": {
          "const": true
        },
        "private_chain_of_thought": {
          "const": "FORBIDDEN"
        }
      }
    },
    "private_reasoning_persistence": {
      "const": "FORBIDDEN"
    }
  }
}
