{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/skill-eval-contract.schema.json",
  "title": "skill-eval-contract/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "skill", "kind", "split", "claims", "task", "conditions", "verifier"],
  "properties": {
    "schema_version": {"const": "skill-eval/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
    "skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "kind": {"enum": ["routing", "capability", "recovery", "adversarial", "composition"]},
    "split": {"enum": ["dev", "holdout", "gold-replay"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["github_issue", "production_incident", "manual", "benchmark"]},
        "ref": {"type": "string", "minLength": 1},
        "captured_commit": {"type": "string", "minLength": 7}
      },
      "required": ["kind", "ref"]
    },
    "implementation_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "anchor"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "anchor": {"type": "string", "minLength": 3}
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_fixture", "negative_fixtures"],
      "properties": {
        "positive_fixture": {"type": "string", "minLength": 1},
        "negative_fixtures": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {"type": "string", "minLength": 10},
        "sealed_ref": {"type": "string", "minLength": 8},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture": {"type": "string", "minLength": 1},
        "expected_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "oneOf": [
        {"required": ["prompt"], "not": {"required": ["sealed_ref"]}},
        {"required": ["sealed_ref", "content_sha256"], "not": {"required": ["prompt"]}}
      ]
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "should_invoke": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "must_not_invoke": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conditions": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"enum": ["no_skill", "current_skill", "candidate_skill", "wrong_skill", "composed_skills"]},
      "contains": {"const": "candidate_skill"}
    },
    "perturbations": {
      "description": "Declared context/tool/state/task disturbances this case may be run under. This axis is orthogonal to conditions (which skill is loaded) and to run identity (model x harness x environment x seed): a perturbation changes the world the case runs in, not who runs it. Absent means the case is only ever run undisturbed; each entry is a named variant a run trace can bind to by id.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "axis", "description", "expected_effect"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "axis": {"enum": ["context", "tool", "state", "task"]},
          "description": {"type": "string", "minLength": 10},
          "expected_effect": {"type": "string", "minLength": 10}
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "fresh_workspace": {"type": "boolean"}, "retries": {"type": "integer", "minimum": 0, "maximum": 3},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200}, "network_policy": {"type": "string", "minLength": 1},
        "seed_count": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["type", "outcome_assertions"],
      "properties": {
        "type": {"enum": ["rule", "script", "artifact", "agent_judge", "composite"]},
        "command": {"type": "string", "minLength": 1},
        "outcome_assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      },
      "allOf": [{"if": {"properties": {"type": {"const": "script"}}}, "then": {"required": ["command"]}}]
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "properties": {"max_tool_calls": {"type": "integer", "minimum": 1}, "max_tokens": {"type": "integer", "minimum": 1}, "max_wall_seconds": {"type": "integer", "minimum": 1}}
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "properties": {"forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}}
    }
  }
}
