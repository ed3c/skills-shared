{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/controlled-language-violation.schema.json",
  "title": "Controlled Language Violation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "violation_id",
    "request_id",
    "constraint_id",
    "intent_id",
    "evidence_class",
    "severity",
    "source_span",
    "message",
    "status",
    "waiver"
  ],
  "properties": {
    "schema_version": {
      "const": "controlled-language-violation/v1"
    },
    "violation_id": {
      "type": "string",
      "pattern": "^V-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "constraint_id": {
      "type": "string",
      "pattern": "^C-[A-Z0-9][A-Z0-9-]{2,127}$"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^MI-[A-Z0-9][A-Z0-9-]{2,127}$"
    },
    "evidence_class": {
      "enum": [
        "DETERMINISTIC",
        "CALIBRATED_HEURISTIC",
        "SEMANTIC",
        "HUMAN"
      ]
    },
    "severity": {
      "enum": [
        "ERROR",
        "WARNING",
        "INFO",
        "HUMAN_REVIEW"
      ]
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "locator",
        "start",
        "end",
        "found_text_digest"
      ],
      "properties": {
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "found_text_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "candidate_rewrite": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "REPAIRED",
        "WAIVED",
        "BLOCKED"
      ]
    },
    "waiver": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_receipt_ref",
            "human_receipt_digest",
            "reason"
          ],
          "properties": {
            "human_receipt_ref": {
              "type": "string",
              "minLength": 1
            },
            "human_receipt_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
