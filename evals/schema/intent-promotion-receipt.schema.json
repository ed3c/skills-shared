{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/intent-promotion-receipt.schema.json",
  "title": "Intent Promotion Receipt",
  "description": "Exact evidence for one lifecycle transition. Shape alone never grants promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "intent_id",
    "contract_identity",
    "intent_bound_contract_identity",
    "subject",
    "from_state",
    "to_state",
    "evidence_fresh",
    "pr_subject",
    "evaluator_receipts",
    "admitted_subject",
    "writebacks",
    "human_approval",
    "lineage",
    "caller_flags",
    "decision",
    "final_status"
  ],
  "properties": {
    "schema_version": {
      "const": "intent-promotion-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^IPR-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^MI-[A-Z0-9][A-Z0-9-]{2,127}$"
    },
    "contract_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "contract_digest"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "intent_bound_contract_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "git_blob_sha"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "tree_sha",
        "branch",
        "pull_request"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pull_request": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "from_state": {
      "enum": [
        "HYPOTHESIS",
        "CANDIDATE",
        "PROPOSED",
        "VERIFIED",
        "ADMITTED",
        "CANONICAL"
      ]
    },
    "to_state": {
      "enum": [
        "CANDIDATE",
        "PROPOSED",
        "VERIFIED",
        "ADMITTED",
        "CANONICAL",
        "SUPERSEDED",
        "REVOKED"
      ]
    },
    "evidence_fresh": {
      "type": "boolean"
    },
    "pr_subject": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "number",
            "head_sha",
            "base_ref",
            "state",
            "observation_digest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "base_ref": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "DRAFT",
                "OPEN",
                "MERGED",
                "CLOSED"
              ]
            },
            "observation_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "evaluator_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evaluator_id",
          "version",
          "implementation_digest",
          "implementation_path",
          "authority",
          "owning",
          "subject_commit_sha",
          "status",
          "output_digest",
          "receipt_digest"
        ],
        "properties": {
          "evaluator_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "implementation_digest": {
            "type": "string",
            "pattern": "^(sha256:[0-9a-f]{64}|git-sha1:[0-9a-f]{40})$"
          },
          "authority": {
            "enum": [
              "LOCAL",
              "OWNING_CI",
              "EXTERNAL"
            ]
          },
          "owning": {
            "type": "boolean"
          },
          "subject_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "ERROR",
              "NOT_EXERCISED",
              "SKIPPED_BY_POLICY",
              "ABSENT"
            ]
          },
          "output_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "receipt_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "implementation_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "admitted_subject": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository",
            "source_head_sha",
            "admitted_identity",
            "status",
            "receipt_digest"
          ],
          "properties": {
            "kind": {
              "enum": [
                "MERGE_COMMIT",
                "RELEASE_ARTIFACT"
              ]
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
            },
            "source_head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "admitted_identity": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|sha256:[0-9a-f]{64})$"
            },
            "status": {
              "const": "ADMITTED"
            },
            "receipt_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "writebacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "destination_id",
          "scope",
          "durability",
          "locator",
          "mode",
          "content_digest",
          "authority_subject",
          "current_projection"
        ],
        "properties": {
          "destination_id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "SESSION",
              "SCRATCHPAD",
              "PR_METADATA",
              "EVIDENCE",
              "MODULE",
              "PROJECT",
              "ROOT_GLOBAL",
              "HISTORY"
            ]
          },
          "durability": {
            "enum": [
              "TRANSIENT",
              "DURABLE"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "APPEND",
              "SUPERSEDE",
              "REVOKE"
            ]
          },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "authority_subject": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|sha256:[0-9a-f]{64})$"
          },
          "current_projection": {
            "type": "boolean"
          }
        }
      }
    },
    "human_approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approver_identity",
            "approver_kind",
            "approval_state",
            "approval_subject",
            "allowed_actions",
            "receipt_digest"
          ],
          "properties": {
            "approver_identity": {
              "type": "string",
              "minLength": 1
            },
            "approver_kind": {
              "enum": [
                "HUMAN",
                "AGENT",
                "AUTOMATION"
              ]
            },
            "approval_state": {
              "enum": [
                "ADMITTED",
                "ABSENT",
                "REVOKED"
              ]
            },
            "approval_subject": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|sha256:[0-9a-f]{64})$"
            },
            "allowed_actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "receipt_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersedes",
        "superseded_by",
        "revocation_reason"
      ],
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "receipt_id",
              "receipt_digest"
            ],
            "properties": {
              "receipt_id": {
                "type": "string",
                "pattern": "^IPR-[A-Z0-9][A-Z0-9-]{2,63}$"
              },
              "receipt_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "receipt_id",
                "receipt_digest"
              ],
              "properties": {
                "receipt_id": {
                  "type": "string",
                  "pattern": "^IPR-[A-Z0-9][A-Z0-9-]{2,63}$"
                },
                "receipt_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "revocation_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "caller_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "PROMOTE",
        "STOP",
        "BLOCK",
        "HUMAN_ADMIT_REQUIRED"
      ]
    },
    "final_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "HUMAN_ADMIT_REQUIRED"
      ]
    }
  }
}
