{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/diagnostic-reflection-receipt.schema.json",
  "title": "Diagnostic Reflection Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "subject_identity",
    "contract_identity",
    "evaluator_identity",
    "failed_constraint_id",
    "intent_at_risk",
    "observation_summary",
    "evidence_refs",
    "diagnosis_code",
    "repair_hypothesis",
    "selected_repair",
    "expected_delta",
    "retry_index",
    "actual_delta",
    "decision",
    "stop_reason"
  ],
  "properties": {
    "schema_version": {"const": "diagnostic-reflection-receipt/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "anyOf": [
        {"required": ["commit_sha"]},
        {"required": ["tree_sha"]},
        {"required": ["artifact_digest"]}
      ]
    },
    "contract_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_version", "contract_sha256"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evaluator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "failed_constraint_id": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
    "intent_at_risk": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^MI-[A-Z0-9-]+$"}
    },
    "observation_summary": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "diagnosis_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "repair_hypothesis": {"type": ["string", "null"]},
    "selected_repair": {"type": ["string", "null"]},
    "expected_delta": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["metric", "before", "target", "direction"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "before": {"type": "number"},
        "target": {"type": "number"},
        "direction": {"enum": ["increase", "decrease", "equal"]}
      }
    },
    "retry_index": {"type": "integer", "minimum": 0},
    "actual_delta": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["after", "improved"],
      "properties": {
        "after": {"type": "number"},
        "improved": {"type": "boolean"}
      }
    },
    "decision": {
      "enum": ["REPAIR", "BLOCK", "REJECT", "HUMAN_ADMIT_REQUIRED", "VERIFIED"]
    },
    "stop_reason": {"type": ["string", "null"]}
  }
}
