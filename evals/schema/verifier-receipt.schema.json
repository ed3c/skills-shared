{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/verifier-receipt.schema.json",
  "title": "skill-eval-verifier-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "case_id", "authority", "verifier", "passed", "input_digest"],
  "properties": {
    "schema_version": {"const": "skill-eval-verifier-receipt/v1"},
    "run_id": {"type": "string", "minLength": 8},
    "case_id": {"type": "string", "minLength": 3},
    "authority": {"enum": ["deterministic", "executor_judge", "llm_judge", "human_review"]},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "implementation_sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "passed": {"type": "boolean"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_command": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
