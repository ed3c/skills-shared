{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/intent-bound-constraint.schema.json",
  "title": "Intent-Bound Constraint Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "subject_identity",
    "module_policy",
    "completion_policy",
    "meta_intents",
    "constraints",
    "diagnostic_reflection_schema"
  ],
  "properties": {
    "schema_version": {"const": "intent-bound-constraint/v1"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "subject_identity": {"$ref": "#/$defs/subjectIdentity"},
    "module_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_add_constraints",
        "may_tighten_constraints",
        "may_weaken_constraints",
        "may_widen_effects",
        "may_bypass_human_admit",
        "ambiguity_action"
      ],
      "properties": {
        "may_add_constraints": {"const": true},
        "may_tighten_constraints": {"const": true},
        "may_weaken_constraints": {"const": false},
        "may_widen_effects": {"const": false},
        "may_bypass_human_admit": {"const": false},
        "ambiguity_action": {"const": "BLOCK"}
      }
    },
    "completion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_failure_vetoes_advisory",
        "stale_evidence_blocks",
        "no_improvement_action",
        "ambiguity_action",
        "private_chain_of_thought"
      ],
      "properties": {
        "deterministic_failure_vetoes_advisory": {"const": true},
        "stale_evidence_blocks": {"const": true},
        "no_improvement_action": {"const": "STOP"},
        "ambiguity_action": {"const": "BLOCK"},
        "private_chain_of_thought": {"const": "FORBIDDEN"}
      }
    },
    "meta_intents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metaIntent"}
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/constraint"}
    },
    "diagnostic_reflection_schema": {
      "const": "evals/schema/diagnostic-reflection-receipt.schema.json"
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "subjectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "anyOf": [
        {"required": ["commit_sha"]},
        {"required": ["tree_sha"]},
        {"required": ["artifact_digest"]}
      ]
    },
    "metaIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "protected_property",
        "priority",
        "scope",
        "forbidden_outcomes",
        "proof_obligations",
        "completion_criteria",
        "human_owned_boundaries"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^MI-[A-Z0-9-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "protected_property": {"type": "string", "minLength": 1},
        "priority": {"enum": ["repository-invariant", "domain-invariant", "task"]},
        "scope": {"$ref": "#/$defs/nonEmptyStrings"},
        "forbidden_outcomes": {"$ref": "#/$defs/nonEmptyStrings"},
        "proof_obligations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^PO-[A-Z0-9-]+$"}
        },
        "completion_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
        "human_owned_boundaries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"enum": ["command", "schema", "external_observation"]},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "schema": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "success_exit_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0, "maximum": 255}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protects_intents",
        "discharges_obligations",
        "subject",
        "trigger",
        "invariant",
        "severity",
        "evidence_class",
        "evaluator",
        "repairability",
        "retry_budget",
        "allowed_repairs",
        "forbidden_repair_codes",
        "expected_delta_metric",
        "negative_controls",
        "mutation_controls"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
        "protects_intents": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^MI-[A-Z0-9-]+$"}
        },
        "discharges_obligations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^PO-[A-Z0-9-]+$"}
        },
        "subject": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "invariant": {"type": "string", "minLength": 1},
        "severity": {"enum": ["hard", "advisory"]},
        "evidence_class": {"enum": ["deterministic", "advisory", "external"]},
        "evaluator": {"$ref": "#/$defs/evaluator"},
        "repairability": {"enum": ["repairable", "terminal", "human_owned"]},
        "retry_budget": {"type": "integer", "minimum": 0, "maximum": 10},
        "allowed_repairs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
        },
        "forbidden_repair_codes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "WEAKEN_CONSTRAINT",
              "EDIT_EVALUATOR_FOR_PASS",
              "DELETE_CONTROL",
              "WIDEN_EFFECTS",
              "BYPASS_HUMAN_ADMIT"
            ]
          }
        },
        "expected_delta_metric": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "negative_controls": {"$ref": "#/$defs/nonEmptyStrings"},
        "mutation_controls": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    }
  }
}
