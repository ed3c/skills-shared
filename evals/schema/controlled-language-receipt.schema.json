{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/controlled-language-receipt.schema.json",
  "title": "Controlled Language Evaluation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "request_identity",
    "subject_identity",
    "profile_identity",
    "termbase_identities",
    "evaluator_runs",
    "violations",
    "repair_history",
    "diagnostic_reflection_receipts",
    "exact_subject_fresh",
    "human_review",
    "claim_level",
    "official_compliance_receipt",
    "final_status"
  ],
  "properties": {
    "schema_version": {
      "const": "controlled-language-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "request_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "artifact_digest"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "subject_identity": {
      "$ref": "#/$defs/subjectIdentity"
    },
    "profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "edition",
        "artifact_digest"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "termbase_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term_id",
          "artifact_digest"
        ],
        "properties": {
          "term_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "evaluator_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evaluator_id",
          "version",
          "evidence_class",
          "status",
          "input_digest",
          "output_digest",
          "exit_code",
          "calibration_ref",
          "human_receipt_ref"
        ],
        "properties": {
          "evaluator_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "DETERMINISTIC",
              "CALIBRATED_HEURISTIC",
              "SEMANTIC",
              "HUMAN"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_EXERCISED",
              "SKIPPED_BY_POLICY"
            ]
          },
          "input_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "output_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "calibration_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "human_receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "violations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_count",
        "blocked_count",
        "waived_count",
        "violation_ids"
      ],
      "properties": {
        "open_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "waived_count": {
          "type": "integer",
          "minimum": 0
        },
        "violation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "repair_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_index",
          "failed_constraint_ids",
          "selected_repair",
          "expected_delta",
          "actual_delta",
          "decision"
        ],
        "properties": {
          "attempt_index": {
            "type": "integer",
            "minimum": 1
          },
          "failed_constraint_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "selected_repair": {
            "type": "string",
            "minLength": 1
          },
          "expected_delta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "before",
              "target"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "number"
              },
              "target": {
                "type": "number"
              }
            }
          },
          "actual_delta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "after",
              "improved"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "number"
              },
              "improved": {
                "type": "boolean"
              }
            }
          },
          "decision": {
            "enum": [
              "REPAIR",
              "STOP",
              "VERIFIED",
              "HUMAN_ADMIT_REQUIRED"
            ]
          }
        }
      }
    },
    "diagnostic_reflection_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "artifact_digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "exact_subject_fresh": {
      "type": "boolean"
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "receipt_ref",
        "receipt_digest"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_REQUIRED",
            "REQUIRED",
            "ADMITTED",
            "REJECTED"
          ]
        },
        "receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "claim_level": {
      "enum": [
        "MECHANISM_ONLY",
        "PROFILE_CONFORMANCE_CANDIDATE",
        "HUMAN_REVIEWED",
        "OFFICIAL_COMPLIANCE"
      ]
    },
    "official_compliance_receipt": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human_receipt_ref",
            "human_receipt_digest"
          ],
          "properties": {
            "human_receipt_ref": {
              "type": "string",
              "minLength": 1
            },
            "human_receipt_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "final_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "HUMAN_ADMIT_REQUIRED"
      ]
    }
  },
  "$defs": {
    "subjectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "locator"
      ],
      "properties": {
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
