{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/capability-unlock.schema.json",
  "title": "capability-unlock/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "skill", "skill_sha", "case_ids", "baseline", "candidate", "supported_stacks", "evidence_bundles"],
  "properties": {
    "schema_version": {"const": "capability-unlock/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
    "skill": {"type": "string", "minLength": 1},
    "skill_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "case_ids": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["no_skill_passes", "current_skill_passes", "total"], "properties": {"no_skill_passes": {"type": "integer", "minimum": 0}, "current_skill_passes": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 6}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["passes", "total"], "properties": {"passes": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 6}}},
    "supported_stacks": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["model", "harness"], "properties": {"model": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}}}},
    "evidence_bundles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
