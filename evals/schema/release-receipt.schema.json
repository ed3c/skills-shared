{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/skills-shared/evals/schema/release-receipt.schema.json",
  "title": "skill-release-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "skill_sha", "eval_suite_sha", "model_harness_matrix", "evidence_bundles", "rollback_sha", "human_admit"],
  "properties": {
    "schema_version": {"const": "skill-release-receipt/v1"},
    "skill": {"type": "string", "minLength": 1},
    "skill_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "eval_suite_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "model_harness_matrix": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["model", "harness", "environment"],
        "properties": {"model": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_bundles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollback_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "human_admit": {
      "type": "object", "additionalProperties": false, "required": ["actor", "admitted_at"],
      "properties": {"actor": {"type": "string", "minLength": 1}, "admitted_at": {"type": "string", "minLength": 10}}
    }
  }
}
