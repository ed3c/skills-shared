  "conditions": [
    "no_skill",
    "current_skill",
    "candidate_skill",
    "wrong_skill"
  ],
  "runtime": {
    "fresh_workspace": true,
    "retries": 0,
    "timeout_seconds": 420,
    "network_policy": "no-network",
    "seed_count": 3
  },
  "verifier": {
    "type": "script",
    "command": "python3 evals/verifiers/verify_repo_agent_native_output.py --case repo-agent-source-anchored-invariants",
    "outcome_assertions": [
      "repo-agent-native is selected",
      "confirmed claims have source references and A or A- evidence",
      "a negative invariant declares its search boundary",
      "unsupported candidates are not promoted"
    ]
  },
  "budgets": {
    "max_tool_calls": 24,
    "max_tokens": 24000,
    "max_wall_seconds": 420
  },
